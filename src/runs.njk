---
layout: layouts/base.njk
title: Runs
description: Recent runs and health stats
rssPath: /feed.xml
metaRobots: "noindex,follow"
pagefindBody: false
---

<h1 data-i18n="runs.title">Runs</h1>

{% if runHistory and runHistory.runs and runHistory.runs.length %}
  <p
    class="muted"
    data-i18n-template="runs.recent"
    data-i18n-vars='{{ { count: runHistory.runs.length } | jsonLd | safe }}'
  >
    Recent {{ runHistory.runs.length }} runs.
  </p>

  {% set staleSources = sourceHealth | selectattr("isStale") | list %}
  {% if staleSources and staleSources.length %}
    <div class="callout callout-stale">
      <strong>Stale sources:</strong>
      {{ staleSources.length }} (>{{ (stats and stats.staleSources and stats.staleSources.days) or 7 }}d no new articles)
      <span class="muted small">
        {% for s in staleSources | slice(0, 5) %}
          {{ s.name or s.id }}{% if s.daysSinceArticle is not null %} ({{ s.daysSinceArticle }}d){% endif %}{% if not loop.last %}, {% endif %}
        {% endfor %}
        {% if staleSources.length > 5 %}…{% endif %}
      </span>
    </div>
  {% endif %}

  <section class="list-controls" data-runs-controls>
    <div class="list-controls-filter" aria-label="Runs controls">
      <button
        class="button button-secondary"
        type="button"
        data-runs-issues-only
        aria-pressed="false"
        data-i18n="runs.filter.issuesOnly"
      >
        Issues only
      </button>
      <label class="tool-option">
        <span data-i18n="runs.filter.order.label">Order:</span>
        <select class="library-select" data-runs-order>
          <option value="desc" data-i18n="runs.filter.order.desc">Newest</option>
          <option value="asc" data-i18n="runs.filter.order.asc">Oldest</option>
        </select>
      </label>
      <button class="button button-secondary" type="button" data-runs-reset data-i18n="runs.filter.clear">
        Reset
      </button>
    </div>
    <p class="muted small tools-filter-status" data-runs-status hidden></p>
  </section>

  <div class="table-wrap">
    <table class="table">
      <caption class="sr-only" data-i18n="runs.caption">Run history</caption>
      <thead>
        <tr>
          <th scope="col" data-i18n="runs.table.finished">Finished</th>
          <th scope="col" data-i18n="runs.table.sources">Sources</th>
          <th scope="col" data-i18n="runs.table.items">Items</th>
          <th scope="col" data-i18n="runs.table.trend">Trend</th>
          <th scope="col" data-i18n="runs.table.cleanup">Cleanup</th>
          <th scope="col" data-i18n="runs.table.articles">Articles</th>
        </tr>
      </thead>
      <tbody>
        {% for r in runHistory.runs %}
          <tr
            class="{% if r.failed > 0 %}row-bad{% elseif r.paused > 0 %}row-paused{% endif %}"
            data-run-finished="{{ r.finishedAt }}"
            data-run-failed="{{ r.failed or 0 }}"
            data-run-paused="{{ r.paused or 0 }}"
          >
            <td class="muted small">{{ r.finishedAt | formatDateTime }}</td>
            <td class="muted small">
              <span
                data-i18n-template="runs.sourcesCell"
                data-i18n-vars='{{ { ok: r.ok or 0, failed: r.failed or 0, paused: r.paused or 0 } | jsonLd | safe }}'
              >
                {{ r.ok or 0 }} OK / {{ r.failed or 0 }} failed / {{ r.paused or 0 }} paused
              </span>
            </td>
            <td class="muted small">
              <span
                data-i18n-template="runs.itemsCell"
                data-i18n-vars='{{ { added: r.added or 0, backfilled: r.backfilled or 0, duplicates: r.duplicates or 0, skipped: r.skipped or 0 } | jsonLd | safe }}'
              >
                {{ r.added or 0 }} added · {{ r.backfilled or 0 }} backfilled · {{ r.duplicates or 0 }} dup ·
                {{ r.skipped or 0 }} skipped
              </span>
              {% if r.retries and r.retries > 0 %}
                <span data-i18n-template="runs.retries" data-i18n-vars='{{ { count: r.retries } | jsonLd | safe }}'>
                  · {{ r.retries }} retries
                </span>
              {% endif %}
            </td>
            <td>
              <span
                class="sr-only"
                id="run-{{ loop.index }}-added"
                data-i18n-template="runs.addedLabel"
                data-i18n-vars='{{ { count: r.added or 0 } | jsonLd | safe }}'
              >
                Added: {{ r.added or 0 }}
              </span>
              <div class="run-spark" aria-labelledby="run-{{ loop.index }}-added">
                <div class="run-spark-bar" style="width: {{ (r.addedPct * 100) }}%"></div>
              </div>
            </td>
            <td class="muted small">
              {% if r.cleanupRemoved %}
                <span
                  data-i18n-template="runs.cleanupDeleted"
                  data-i18n-vars='{{ { count: r.cleanupRemoved } | jsonLd | safe }}'
                >
                  deleted {{ r.cleanupRemoved }}
                </span>
              {% else %}
                <span class="muted">—</span>
              {% endif %}
            </td>
            <td class="muted small">
              {% if r.totalArticles %}
                {{ r.totalArticles }}
                {% if r.storyClusters and r.storyClusters > 0 %}
                  <span
                    data-i18n-template="runs.stories"
                    data-i18n-vars='{{ { count: r.storyClusters } | jsonLd | safe }}'
                  >
                    · {{ r.storyClusters }} stories
                  </span>
                {% endif %}
              {% else %}
                <span class="muted">—</span>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% else %}
  <p class="muted" data-i18n="runs.empty">No run history yet. Check back later.</p>
{% endif %}
