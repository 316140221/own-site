---
layout: layouts/base.njk
rssPath: /feed.xml
headerNavMode: minimal
showNewsNav: true
---

<h1>{{ site.name }}</h1>
{% if site.tagline or site.description %}
  <p class="muted">
    {% if site.tagline %}{{ site.tagline }}{% endif %}{% if site.tagline and site.description %} · {% endif %}{% if site.description %}{{ site.description }}{% endif %}
  </p>
{% endif %}

<h2 data-i18n="home.start">Start</h2>
<nav class="tool-cards" aria-label="Quick links">
  <a class="tool-card" href="{{ '/page/1/' | url }}">
    <div class="tool-card-title" data-i18n="home.latest">Latest</div>
  </a>
  <a class="tool-card" href="{{ '/trending/' | url }}">
    <div class="tool-card-title" data-i18n="nav.trending">Trending</div>
  </a>
  <a class="tool-card" href="{{ '/tools/' | url }}">
    <div class="tool-card-title" data-i18n="nav.tools">Tools</div>
  </a>
  <a class="tool-card" href="{{ '/search/' | url }}">
    <div class="tool-card-title" data-i18n="nav.search">Search</div>
  </a>
  <a class="tool-card" href="{{ '/library/' | url }}">
    <div class="tool-card-title" data-i18n="nav.library">Library</div>
  </a>
  <a class="tool-card" href="{{ '/sources/' | url }}">
    <div class="tool-card-title" data-i18n="sources.title">Sources</div>
  </a>
  <a class="tool-card" href="{{ '/about/' | url }}">
    <div class="tool-card-title" data-i18n="nav.about">About</div>
  </a>
</nav>

<h2 data-i18n="home.latest">Latest</h2>
{% set items = (news.latest | slice(0, 8)) %}
{% include "partials/news-list.njk" %}
<p class="home-actions">
  <a class="button button-secondary" href="{{ '/page/1/' | url }}" data-i18n="home.latestMore"
    >View all</a
  >
</p>

<h2 data-i18n="nav.trending">Trending</h2>
<p
  class="muted"
  data-i18n-template="trending.subtitle"
  data-i18n-vars='{{ { hours: stories.windowHours } | jsonLd | safe }}'
>
  Stories are clustered by similar titles from the last {{ stories.windowHours }} hours.
</p>
{% if stories and stories.items and stories.items.length %}
  <ol class="story-list">
    {% for story in stories.items | slice(0, 3) %}
      <li class="story">
        <div class="story-head">
          {% set primaryId = "" %}
          {% if story.items and story.items.length %}
            {% set primaryId = story.items[0].id %}
          {% endif %}
          <h3 class="story-title">
            {% if primaryId %}
              <a href="{{ ('/p/' + primaryId + '/') | url }}">{{ story.title | decodeEntities }}</a>
            {% else %}
              {{ story.title | decodeEntities }}
            {% endif %}
          </h3>
          <div class="story-meta muted small">
            <span>{{ story.publishedAt | formatDateTime }}</span>
            <span aria-hidden="true"> · </span>
            <span
              data-i18n-template="trending.coverage"
              data-i18n-vars='{{ { coverage: story.coverage } | jsonLd | safe }}'
            >
              Coverage {{ story.coverage }}
            </span>
          </div>
          {% if story.sources and story.sources.length %}
            <div class="story-sources">
              {% for s in story.sources | slice(0, 6) %}
                <span class="badge">{{ s }}</span>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ol>
{% else %}
  <p class="muted" data-i18n="trending.empty">No stories yet. Check back later.</p>
{% endif %}
<p class="home-actions">
  <a class="button button-secondary" href="{{ '/trending/' | url }}" data-i18n="nav.trending"
    >Trending</a
  >
</p>

<h2 data-i18n="home.tools">Tools</h2>
<p class="muted" data-i18n="home.randomToolsNote">Random picks refreshed regularly.</p>
{% if home and home.randomTools and home.randomTools.length %}
  <div class="tool-cards">
    {% for t in home.randomTools %}
      <a class="tool-card" href="{{ t.path | url }}">
        <div class="tool-card-title" data-i18n="tools.item.{{ t.slug }}.title">{{ t.label }}</div>
        {% if t.description %}
          <div class="tool-card-desc" data-i18n="tools.item.{{ t.slug }}.desc">{{ t.description }}</div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
{% else %}
  <p class="muted" data-i18n="home.noTools">No tools yet.</p>
{% endif %}
<p class="home-actions">
  <a class="button button-secondary" href="{{ '/tools/' | url }}" data-i18n="home.toolsAll">All tools</a>
</p>
