---
layout: layouts/base.njk
title: Languages
rssPath: /feed.xml
---

<h1 data-i18n="languages.title">Languages</h1>

{% if languages and languages.length %}
  <ul class="sources">
    {% for lang in languages %}
      <li>
        <a href="{{ ('/lang/' + lang.code + '/') | url }}">{{ lang.label }}</a>
        <span class="muted">({{ lang.code }})</span>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p class="muted" data-i18n="languages.empty">No languages detected.</p>
{% endif %}
