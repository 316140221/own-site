---
layout: layouts/base.njk
title: "Inflation Calculator"
description: "Estimate future value or today’s value using an inflation rate. Runs locally."
pageScript: "/assets/tools/inflation.js"
---

<h1 data-i18n="tools.item.inflation.title">Inflation Calculator</h1>
<p class="muted" data-i18n="tools.localNotice">Runs locally in your browser. Nothing is uploaded.</p>
<p class="muted small" data-i18n="tool.inflation.disclaimer">Estimates only. Uses a constant inflation rate.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.inflation.amount">Amount</span>
          <input
            type="text"
            id="opt-amount"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="tool-input-wide"
            placeholder="e.g. 1000"
            data-i18n-placeholder="tool.inflation.amountPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.inflation.mode">Mode</span>
          <select id="opt-mode">
            <option value="inflate" data-i18n="tool.inflation.mode.inflate">Future value (inflation)</option>
            <option value="deflate" data-i18n="tool.inflation.mode.deflate">Value in today’s dollars</option>
          </select>
        </label>

        <label class="tool-option">
          <span data-i18n="tool.inflation.rate">Inflation rate %</span>
          <input type="number" id="opt-rate" min="0" max="100" step="0.01" value="3.00" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.inflation.years">Years</span>
          <input type="number" id="opt-years" min="0" max="200" step="1" value="10" />
        </label>

        <label class="tool-option">
          <input type="checkbox" id="opt-show-breakdown" />
          <span data-i18n="tool.inflation.showBreakdown">Show yearly breakdown</span>
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="16"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.inflation.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

