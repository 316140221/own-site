---
layout: layouts/base.njk
title: "ULID Generator"
description: "Generate ULIDs locally (time-sortable identifiers). Runs locally."
pageScript: "/assets/tools/ulid.js"
---

<h1 data-i18n="tools.item.ulid.title">ULID Generator</h1>


<section class="tool-shell">
  <div class="tool-pane">
    <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
    <textarea
      id="tool-output"
      class="tool-textarea"
      rows="10"
      readonly
      placeholder="Result will appear here…"
      data-i18n-placeholder="tool.common.resultPlaceholder"
      spellcheck="false"
    ></textarea>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-generate" data-i18n="tool.ulid.generate">Generate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">Clear</button>
  </div>

  <div class="tool-options">
    <label class="tool-option">
      <span data-i18n="tool.ulid.count">Count:</span>
      <input type="number" id="opt-count" min="1" max="100" value="5" />
    </label>
    <label class="tool-option">
      <input type="checkbox" id="opt-monotonic" checked />
      <span data-i18n="tool.ulid.monotonic">Monotonic (same timestamp)</span>
    </label>
    <label class="tool-option">
      <input type="checkbox" id="opt-lowercase" />
      <span data-i18n="tool.ulid.lowercase">Lowercase</span>
    </label>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

