---
layout: layouts/base.njk
title: "Rent Affordability Calculator"
description: "Estimate max affordable rent (or required income) using the rent-to-income rule. Runs locally."
pageScript: "/assets/tools/rent-affordability.js"
---

<h1 data-i18n="tools.item.rent-affordability.title">Rent Affordability Calculator</h1>


<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <label class="tool-label" for="tool-input" data-i18n="tool.rentAfford.amount">Amount</label>
      <input
        id="tool-input"
        class="tool-textarea"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        spellcheck="false"
        placeholder="e.g. 6000"
        data-i18n-placeholder="tool.rentAfford.amountPlaceholder"
      />

      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.rentAfford.mode">Mode</span>
          <select id="opt-mode">
            <option value="incomeToRent" data-i18n="tool.rentAfford.mode.incomeToRent">Income → Max rent</option>
            <option value="rentToIncome" data-i18n="tool.rentAfford.mode.rentToIncome">Rent → Required income</option>
          </select>
        </label>
        <label class="tool-option">
          <span data-i18n="tool.rentAfford.percent">Rent as % of income</span>
          <input type="number" id="opt-percent" min="1" max="90" step="0.1" value="30" />
        </label>
        <div class="tool-option" aria-label="Percent presets">
          <span data-i18n="tool.rentAfford.presets">Presets:</span>
          <button class="tag-pill" type="button" data-percent-preset="25">25%</button>
          <button class="tag-pill" type="button" data-percent-preset="30">30%</button>
          <button class="tag-pill" type="button" data-percent-preset="33.33">33.33%</button>
        </div>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="12"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.rentAfford.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

