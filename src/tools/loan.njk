---
layout: layouts/base.njk
title: "Loan Calculator"
description: "Calculate loan payments, totals, and payoff with extra payments. Runs locally."
pageScript: "/assets/tools/loan.js"
---

<h1 data-i18n="tools.item.loan.title">Loan Calculator</h1>

<p class="muted small" data-i18n="tool.loan.disclaimer">Estimates only. Not financial advice.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.loan.amount">Loan amount</span>
          <input
            type="text"
            id="opt-amount"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="tool-input-wide"
            placeholder="e.g. 15000"
            data-i18n-placeholder="tool.loan.amountPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.loan.apr">APR %</span>
          <input type="number" id="opt-apr" min="0" max="100" step="0.01" value="7.50" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.loan.termMonths">Term</span>
          <input type="number" id="opt-term" min="1" max="600" step="1" value="60" />
          <span class="muted small" data-i18n="tool.loan.months">months</span>
        </label>

        <div class="tool-option" aria-label="Term presets">
          <span data-i18n="tool.loan.termPresets">Presets:</span>
          <button class="tag-pill" type="button" data-term-preset="12">12</button>
          <button class="tag-pill" type="button" data-term-preset="24">24</button>
          <button class="tag-pill" type="button" data-term-preset="36">36</button>
          <button class="tag-pill" type="button" data-term-preset="48">48</button>
          <button class="tag-pill" type="button" data-term-preset="60">60</button>
          <button class="tag-pill" type="button" data-term-preset="72">72</button>
          <button class="tag-pill" type="button" data-term-preset="84">84</button>
        </div>

        <label class="tool-option">
          <span data-i18n="tool.loan.extra">Extra payment / month</span>
          <input
            type="text"
            id="opt-extra"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="e.g. 50"
            data-i18n-placeholder="tool.loan.extraPlaceholder"
          />
        </label>

        <label class="tool-option">
          <input type="checkbox" id="opt-show-schedule" />
          <span data-i18n="tool.loan.showSchedule">Show first 12 payments</span>
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="14"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.loan.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

