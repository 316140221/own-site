---
layout: layouts/base.njk
title: "UTM Link Builder"
description: "Generate tracking links with UTM parameters locally. Runs locally."
pageScript: "/assets/tools/utm.js"
---

<h1 data-i18n="tools.item.utm.title">UTM Link Builder</h1>
<p class="muted" data-i18n="tools.localNotice">Runs locally in your browser. Nothing is uploaded.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <label class="tool-label" for="tool-input" data-i18n="tool.utm.url">URL</label>
      <textarea
        id="tool-input"
        class="tool-textarea"
        rows="4"
        placeholder="Paste a URL…"
        data-i18n-placeholder="tool.utm.urlPlaceholder"
        spellcheck="false"
      ></textarea>

      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.utm.source">utm_source:</span>
          <input type="text" id="opt-source" />
        </label>
        <label class="tool-option">
          <span data-i18n="tool.utm.medium">utm_medium:</span>
          <input type="text" id="opt-medium" />
        </label>
        <label class="tool-option">
          <span data-i18n="tool.utm.campaign">utm_campaign:</span>
          <input type="text" id="opt-campaign" />
        </label>
        <label class="tool-option">
          <span data-i18n="tool.utm.term">utm_term:</span>
          <input type="text" id="opt-term" />
        </label>
        <label class="tool-option">
          <span data-i18n="tool.utm.content">utm_content:</span>
          <input type="text" id="opt-content" />
        </label>
        <label class="tool-option">
          <span data-i18n="tool.utm.custom">Custom:</span>
          <input
            class="tool-input-wide"
            type="text"
            id="opt-custom"
            placeholder="ref=twitter&foo=bar"
            data-i18n-placeholder="tool.utm.customPlaceholder"
          />
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="10"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-generate" data-i18n="tool.utm.generate">Generate</button>
    <button class="button button-secondary" type="button" id="btn-open" data-i18n="tool.utm.open">Open</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

