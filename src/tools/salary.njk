---
layout: layouts/base.njk
title: "Salary Calculator"
description: "Convert between annual salary and hourly pay (monthly/biweekly/weekly). Runs locally."
pageScript: "/assets/tools/salary.js"
---

<h1 data-i18n="tools.item.salary.title">Salary Calculator</h1>


<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <label class="tool-label" for="tool-input" data-i18n="tool.salary.amount">Amount</label>
      <input
        id="tool-input"
        class="tool-textarea"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        spellcheck="false"
        placeholder="e.g. 75000"
        data-i18n-placeholder="tool.salary.amountPlaceholder"
      />

      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.salary.mode">Mode</span>
          <select id="opt-mode">
            <option value="salary" data-i18n="tool.salary.mode.salary">Salary (annual)</option>
            <option value="hourly" data-i18n="tool.salary.mode.hourly">Hourly</option>
          </select>
        </label>
        <label class="tool-option">
          <span data-i18n="tool.salary.hoursPerWeek">Hours / week</span>
          <input type="number" id="opt-hours" min="1" max="168" step="0.5" value="40" />
        </label>
        <label class="tool-option">
          <span data-i18n="tool.salary.weeksPerYear">Weeks / year</span>
          <input type="number" id="opt-weeks" min="1" max="53" step="1" value="52" />
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="12"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.salary.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

