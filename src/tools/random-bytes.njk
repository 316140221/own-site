---
layout: layouts/base.njk
title: "Random Bytes Generator"
description: "Generate random bytes / API keys locally (hex, base64, base64url). Runs locally."
pageScript: "/assets/tools/random-bytes.js"
---

<h1 data-i18n="tools.item.random-bytes.title">Random Bytes Generator</h1>


<section class="tool-shell">
  <div class="tool-pane">
    <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
    <textarea
      id="tool-output"
      class="tool-textarea"
      rows="10"
      readonly
      placeholder="Result will appear here…"
      data-i18n-placeholder="tool.common.resultPlaceholder"
      spellcheck="false"
    ></textarea>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-generate" data-i18n="tool.randomBytes.generate">
      Generate
    </button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">Clear</button>
  </div>

  <div class="tool-options">
    <label class="tool-option">
      <span data-i18n="tool.randomBytes.bytes">Bytes:</span>
      <input type="number" id="opt-bytes" min="1" max="4096" value="32" />
    </label>
    <label class="tool-option">
      <span data-i18n="tool.randomBytes.count">Count:</span>
      <input type="number" id="opt-count" min="1" max="50" value="5" />
    </label>
    <label class="tool-option">
      <span data-i18n="tool.randomBytes.encoding">Encoding:</span>
      <select id="opt-encoding">
        <option value="hex" data-i18n="tool.randomBytes.encoding.hex">HEX</option>
        <option value="base64" data-i18n="tool.randomBytes.encoding.base64">Base64</option>
        <option value="base64url" data-i18n="tool.randomBytes.encoding.base64url">Base64URL</option>
      </select>
    </label>
    <label class="tool-option">
      <input type="checkbox" id="opt-uppercase" checked />
      <span data-i18n="tool.randomBytes.uppercase">Uppercase HEX</span>
    </label>
    <label class="tool-option">
      <input type="checkbox" id="opt-prefix" />
      <span data-i18n="tool.randomBytes.prefix">Prefix 0x</span>
    </label>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

