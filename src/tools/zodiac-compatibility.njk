---
layout: layouts/base.njk
title: "Zodiac Compatibility"
description: "Fun compatibility score and tips by zodiac sign (entertainment only). Runs locally."
pageScript: "/assets/tools/zodiac-compatibility.js"
---

<h1 data-i18n="tools.item.zodiac-compatibility.title">Zodiac Compatibility</h1>
<p class="muted" data-i18n="tools.localNotice">Runs locally in your browser. Nothing is uploaded.</p>
<p class="muted small" data-i18n="tool.zodiacCompat.disclaimer">For entertainment only. Not advice.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.zodiacCompat.you">Your sign</span>
          <select id="opt-you">
            <option value="aries">Aries</option>
            <option value="taurus">Taurus</option>
            <option value="gemini">Gemini</option>
            <option value="cancer">Cancer</option>
            <option value="leo">Leo</option>
            <option value="virgo">Virgo</option>
            <option value="libra">Libra</option>
            <option value="scorpio">Scorpio</option>
            <option value="sagittarius">Sagittarius</option>
            <option value="capricorn">Capricorn</option>
            <option value="aquarius">Aquarius</option>
            <option value="pisces">Pisces</option>
          </select>
        </label>

        <label class="tool-option">
          <span data-i18n="tool.zodiacCompat.them">Their sign</span>
          <select id="opt-them">
            <option value="aries">Aries</option>
            <option value="taurus">Taurus</option>
            <option value="gemini">Gemini</option>
            <option value="cancer">Cancer</option>
            <option value="leo">Leo</option>
            <option value="virgo">Virgo</option>
            <option value="libra">Libra</option>
            <option value="scorpio">Scorpio</option>
            <option value="sagittarius">Sagittarius</option>
            <option value="capricorn">Capricorn</option>
            <option value="aquarius">Aquarius</option>
            <option value="pisces">Pisces</option>
          </select>
        </label>

        <label class="tool-option">
          <span data-i18n="tool.zodiacCompat.type">Type</span>
          <select id="opt-type">
            <option value="love" data-i18n="tool.zodiacCompat.type.love">Love</option>
            <option value="friendship" data-i18n="tool.zodiacCompat.type.friendship">Friendship</option>
            <option value="work" data-i18n="tool.zodiacCompat.type.work">Work</option>
          </select>
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="12"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-generate" data-i18n="tool.zodiacCompat.generate">Generate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

