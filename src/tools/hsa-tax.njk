---
layout: layouts/base.njk
title: "HSA Tax Savings Calculator"
description: "Estimate HSA tax savings and after-tax cost with 2024 limits. Runs locally."
pageScript: "/assets/tools/hsa-tax.js"
---

<h1 data-i18n="tools.item.hsa-tax.title">HSA Tax Savings Calculator</h1>
<p class="muted" data-i18n="tools.localNotice">Runs locally in your browser. Nothing is uploaded.</p>
<p class="muted small" data-i18n="tool.hsa.disclaimer">Estimates only. Not tax or legal advice.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.hsa.status">Coverage</span>
          <select id="opt-status">
            <option value="single" data-i18n="tool.hsa.status.single">Self-only</option>
            <option value="family" data-i18n="tool.hsa.status.family">Family</option>
          </select>
        </label>

        <label class="tool-option">
          <span data-i18n="tool.hsa.contribution">Your contribution</span>
          <input
            type="text"
            id="opt-contrib"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="tool-input-wide"
            placeholder="e.g. 3500"
            data-i18n-placeholder="tool.hsa.contributionPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.hsa.employer">Employer contribution (optional)</span>
          <input
            type="text"
            id="opt-employer"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="e.g. 800"
            data-i18n-placeholder="tool.hsa.employerPlaceholder"
          />
        </label>

        <label class="tool-option">
          <input type="checkbox" id="opt-catchup" />
          <span data-i18n="tool.hsa.catchup">Age 55+ catch-up ($1,000)</span>
        </label>

        <label class="tool-option">
          <span data-i18n="tool.hsa.limitOverride">Custom annual limit (optional)</span>
          <input
            type="text"
            id="opt-limit"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="Leave blank to use 2024 limit"
            data-i18n-placeholder="tool.hsa.limitPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.hsa.taxRate">Combined tax rate %</span>
          <input type="number" id="opt-tax" min="0" max="70" step="0.1" value="32" />
          <span class="muted small" data-i18n="tool.hsa.taxHint">Include federal + state + payroll taxes.</span>
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="18"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.hsa.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>
