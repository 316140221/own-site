---
layout: layouts/base.njk
title: "Image → Base64"
description: "Convert images to Data URL / Base64 / HTML / Markdown locally. Runs locally."
pageScript: "/assets/tools/image-base64.js"
---

<h1 data-i18n="tools.item.image-base64.title">Image → Base64</h1>


<section class="tool-shell">
  <div class="tool-pane">
    <label class="tool-label" for="tool-file" data-i18n="tool.imageBase64.file">Image file</label>
    <input type="file" id="tool-file" class="tool-file" accept="image/*" />
    <p class="muted small" id="tool-file-meta"></p>
  </div>

  <div class="tool-options">
    <label class="tool-option">
      <span data-i18n="tool.imageBase64.mode">Output:</span>
      <select id="opt-mode">
        <option value="dataUrl" data-i18n="tool.imageBase64.mode.dataUrl">Data URL</option>
        <option value="base64" data-i18n="tool.imageBase64.mode.base64">Base64</option>
        <option value="html" data-i18n="tool.imageBase64.mode.html">HTML &lt;img&gt;</option>
        <option value="markdown" data-i18n="tool.imageBase64.mode.markdown">Markdown</option>
        <option value="css" data-i18n="tool.imageBase64.mode.css">CSS url()</option>
      </select>
    </label>
    <label class="tool-option">
      <span data-i18n="tool.imageBase64.alt">Alt text:</span>
      <input
        type="text"
        id="opt-alt"
        class="tool-input-wide"
        placeholder="Optional"
        data-i18n-placeholder="tool.imageBase64.altPlaceholder"
      />
    </label>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-generate" data-i18n="tool.imageBase64.generate">Generate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">Clear</button>
  </div>

  <div class="tool-pane tool-pane-block">
    <div class="tool-label" data-i18n="tool.imageBase64.preview">Preview</div>
    <div class="tool-preview-box">
      <img id="preview-image" class="tool-preview-img" alt="" loading="lazy" decoding="async" />
    </div>
  </div>

  <div class="tool-pane tool-pane-block">
    <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
    <textarea
      id="tool-output"
      class="tool-textarea"
      rows="9"
      readonly
      placeholder="Result will appear here…"
      data-i18n-placeholder="tool.common.resultPlaceholder"
      spellcheck="false"
    ></textarea>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>
