---
layout: layouts/base.njk
title: "529 Plan Savings Calculator"
description: "Project 529 plan growth and state tax deduction impact. Runs locally."
pageScript: "/assets/tools/529-plan.js"
---

<h1 data-i18n="tools.item.529-plan.title">529 Plan Savings Calculator</h1>

<p class="muted small" data-i18n="tool.plan529.disclaimer">Estimates only. Not tax advice.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.plan529.current">Current balance</span>
          <input
            type="text"
            id="opt-current"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="tool-input-wide"
            placeholder="e.g. 12000"
            data-i18n-placeholder="tool.plan529.currentPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.plan529.monthly">Monthly contribution</span>
          <input
            type="text"
            id="opt-monthly"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="e.g. 400"
            data-i18n-placeholder="tool.plan529.monthlyPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.plan529.years">Years until college</span>
          <input type="number" id="opt-years" min="0" max="30" step="1" value="12" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.plan529.return">Annual return %</span>
          <input type="number" id="opt-return" min="0" max="15" step="0.1" value="6.0" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.plan529.stateDeduct">State deduction cap / year</span>
          <input
            type="text"
            id="opt-deduct"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="e.g. 4000"
            data-i18n-placeholder="tool.plan529.deductPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.plan529.taxRate">State tax rate %</span>
          <input type="number" id="opt-tax" min="0" max="15" step="0.1" value="5.0" />
        </label>

        <label class="tool-option">
          <input type="checkbox" id="opt-show-table" />
          <span data-i18n="tool.plan529.showTable">Show yearly projection</span>
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="18"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.plan529.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>
