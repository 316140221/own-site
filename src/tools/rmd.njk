---
layout: layouts/base.njk
title: "RMD Calculator"
description: "Estimate Required Minimum Distributions using the Uniform Lifetime Table. Runs locally."
pageScript: "/assets/tools/rmd.js"
---

<h1 data-i18n="tools.item.rmd.title">RMD Calculator</h1>
<p class="muted" data-i18n="tools.localNotice">Runs locally in your browser. Nothing is uploaded.</p>
<p class="muted small" data-i18n="tool.rmd.disclaimer">Estimates only. Not tax advice.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.rmd.balance">IRA/401(k) balance (prior 12/31)</span>
          <input
            type="text"
            id="opt-balance"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="tool-input-wide"
            placeholder="e.g. 650000"
            data-i18n-placeholder="tool.rmd.balancePlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.rmd.age">Age this year</span>
          <input type="number" id="opt-age" min="50" max="110" step="1" value="73" />
        </label>

        <label class="tool-option">
          <input type="checkbox" id="opt-show-table" />
          <span data-i18n="tool.rmd.showTable">Show ages 70-95</span>
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="18"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.rmd.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>
