---
layout: layouts/base.njk
title: "Date Difference"
description: "Compute time differences between two dates (days, hours, minutes). Runs locally."
pageScript: "/assets/tools/date-diff.js"
---

<h1 data-i18n="tools.item.date-diff.title">Date Difference</h1>
<p class="muted" data-i18n="tools.localNotice">Runs locally in your browser. Nothing is uploaded.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <label class="tool-label" for="opt-start" data-i18n="tool.dateDiff.start">Start</label>
      <input id="opt-start" class="tool-file" type="datetime-local" />

      <div class="tool-pane-block">
        <label class="tool-label" for="opt-end" data-i18n="tool.dateDiff.end">End</label>
        <input id="opt-end" class="tool-file" type="datetime-local" />
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="10"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.dateDiff.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-now" data-i18n="tool.dateDiff.now">Now</button>
    <button class="button button-secondary" type="button" id="btn-swap" data-i18n="tool.dateDiff.swap">Swap</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>
