---
layout: layouts/base.njk
title: "College Savings Calculator"
description: "Plan college savings: project balance and required monthly contributions. Runs locally."
pageScript: "/assets/tools/college-savings.js"
---

<h1 data-i18n="tools.item.college-savings.title">College Savings Calculator</h1>
<p class="muted" data-i18n="tools.localNotice">Runs locally in your browser. Nothing is uploaded.</p>
<p class="muted small" data-i18n="tool.collegeSavings.disclaimer">Estimates only. Not financial advice.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.collegeSavings.goal">College cost goal</span>
          <input
            type="text"
            id="opt-goal"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="tool-input-wide"
            placeholder="e.g. 200000"
            data-i18n-placeholder="tool.collegeSavings.goalPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.collegeSavings.current">Current savings</span>
          <input
            type="text"
            id="opt-current"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="e.g. 15000"
            data-i18n-placeholder="tool.collegeSavings.currentPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.collegeSavings.years">Years until college</span>
          <input type="number" id="opt-years" min="0" max="30" step="1" value="12" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.collegeSavings.return">Annual return %</span>
          <input type="number" id="opt-return" min="0" max="15" step="0.1" value="6.0" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.collegeSavings.monthly">Monthly contribution</span>
          <input
            type="text"
            id="opt-monthly"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="e.g. 400"
            data-i18n-placeholder="tool.collegeSavings.monthlyPlaceholder"
          />
        </label>

        <label class="tool-option">
          <input type="checkbox" id="opt-show-table" />
          <span data-i18n="tool.collegeSavings.showTable">Show yearly projection</span>
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="18"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.collegeSavings.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>
