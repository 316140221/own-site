---
layout: layouts/base.njk
title: "Discount Calculator"
description: "Calculate discount amount, final price, and totals (with optional sales tax). Runs locally."
pageScript: "/assets/tools/discount.js"
---

<h1 data-i18n="tools.item.discount.title">Discount Calculator</h1>
<p class="muted" data-i18n="tools.localNotice">Runs locally in your browser. Nothing is uploaded.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <label class="tool-label" for="tool-input" data-i18n="tool.discount.price">Price</label>
      <input
        id="tool-input"
        class="tool-textarea"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        spellcheck="false"
        placeholder="e.g. 49.99"
        data-i18n-placeholder="tool.discount.pricePlaceholder"
      />

      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.discount.discountPercent">Discount %</span>
          <input type="number" id="opt-discount" min="0" max="100" step="0.01" value="20" />
        </label>
        <label class="tool-option">
          <span data-i18n="tool.discount.taxRate">Sales tax % (optional)</span>
          <input type="number" id="opt-tax" min="0" max="25" step="0.01" value="0" />
        </label>
        <label class="tool-option">
          <span data-i18n="tool.discount.qty">Qty</span>
          <input type="number" id="opt-qty" min="1" max="1000" step="1" value="1" />
        </label>
        <div class="tool-option" aria-label="Discount presets">
          <span data-i18n="tool.discount.presets">Presets:</span>
          <button class="tag-pill" type="button" data-discount-preset="10">10%</button>
          <button class="tag-pill" type="button" data-discount-preset="15">15%</button>
          <button class="tag-pill" type="button" data-discount-preset="20">20%</button>
          <button class="tag-pill" type="button" data-discount-preset="25">25%</button>
          <button class="tag-pill" type="button" data-discount-preset="30">30%</button>
          <button class="tag-pill" type="button" data-discount-preset="40">40%</button>
          <button class="tag-pill" type="button" data-discount-preset="50">50%</button>
        </div>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="12"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.discount.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

