---
layout: layouts/base.njk
title: "Daily Horoscope"
description: "Daily horoscope by zodiac sign (for entertainment only). Runs locally."
pageScript: "/assets/tools/horoscope.js"
---

<h1 data-i18n="tools.item.horoscope.title">Daily Horoscope</h1>
<p class="muted" data-i18n="tools.localNotice">Runs locally in your browser. Nothing is uploaded.</p>
<p class="muted small" data-i18n="tool.horoscope.disclaimer">
  For entertainment only. Not advice.
</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <label class="tool-label" for="opt-sign" data-i18n="tool.horoscope.sign">Zodiac sign</label>
      <select id="opt-sign" class="tool-file">
        <option value="aries">Aries</option>
        <option value="taurus">Taurus</option>
        <option value="gemini">Gemini</option>
        <option value="cancer">Cancer</option>
        <option value="leo">Leo</option>
        <option value="virgo">Virgo</option>
        <option value="libra">Libra</option>
        <option value="scorpio">Scorpio</option>
        <option value="sagittarius">Sagittarius</option>
        <option value="capricorn">Capricorn</option>
        <option value="aquarius">Aquarius</option>
        <option value="pisces">Pisces</option>
      </select>

      <div class="tool-pane-block">
        <label class="tool-label" for="opt-date" data-i18n="tool.horoscope.date">Date</label>
        <input id="opt-date" class="tool-file" type="date" />
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="12"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-generate" data-i18n="tool.horoscope.generate">Generate</button>
    <button class="button button-secondary" type="button" id="btn-today" data-i18n="tool.horoscope.today">
      Today
    </button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

