---
layout: layouts/base.njk
title: "FSA vs HSA Savings Calculator"
description: "Compare tax savings between FSA and HSA with contribution limits. Runs locally."
pageScript: "/assets/tools/fsa-vs-hsa.js"
---

<h1 data-i18n="tools.item.fsa-vs-hsa.title">FSA vs HSA Savings Calculator</h1>

<p class="muted small" data-i18n="tool.fsaHsa.disclaimer">Estimates only. Not tax or legal advice.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.fsaHsa.taxRate">Combined tax rate %</span>
          <input type="number" id="opt-tax" min="0" max="70" step="0.1" value="32" />
          <span class="muted small" data-i18n="tool.fsaHsa.taxHint">Federal + state + payroll.</span>
        </label>

        <label class="tool-option">
          <span data-i18n="tool.fsaHsa.fsa">FSA contribution</span>
          <input
            type="text"
            id="opt-fsa"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="tool-input-wide"
            placeholder="e.g. 3000"
            data-i18n-placeholder="tool.fsaHsa.fsaPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.fsaHsa.hsa">HSA contribution (employee)</span>
          <input
            type="text"
            id="opt-hsa"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="e.g. 4000"
            data-i18n-placeholder="tool.fsaHsa.hsaPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.fsaHsa.employer">HSA employer contribution</span>
          <input
            type="text"
            id="opt-employer"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="e.g. 800"
            data-i18n-placeholder="tool.fsaHsa.employerPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.fsaHsa.limitFsa">FSA limit (override)</span>
          <input
            type="text"
            id="opt-limit-fsa"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="Leave blank to use default"
            data-i18n-placeholder="tool.fsaHsa.limitPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.fsaHsa.limitHsa">HSA limit (override)</span>
          <input
            type="text"
            id="opt-limit-hsa"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="Leave blank to use default"
            data-i18n-placeholder="tool.fsaHsa.limitPlaceholder"
          />
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="18"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.fsaHsa.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>
