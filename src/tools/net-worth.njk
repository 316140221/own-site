---
layout: layouts/base.njk
title: "Net Worth Calculator"
description: "Calculate net worth from assets and liabilities. Runs locally."
pageScript: "/assets/tools/net-worth.js"
---

<h1 data-i18n="tools.item.net-worth.title">Net Worth Calculator</h1>

<p class="muted small" data-i18n="tool.netWorth.disclaimer">Estimates only. Not financial advice.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <label class="tool-label" for="opt-assets" data-i18n="tool.netWorth.assets">Assets (one per line)</label>
      <textarea
        id="opt-assets"
        class="tool-textarea"
        rows="7"
        autocomplete="off"
        spellcheck="false"
        placeholder="e.g.&#10;Checking: 1500&#10;401(k): 23000"
        data-i18n-placeholder="tool.netWorth.assetsPlaceholder"
      ></textarea>

      <label class="tool-label" for="opt-liabilities" data-i18n="tool.netWorth.liabilities"
        >Liabilities (one per line)</label
      >
      <textarea
        id="opt-liabilities"
        class="tool-textarea"
        rows="7"
        autocomplete="off"
        spellcheck="false"
        placeholder="e.g.&#10;Credit card: 1200&#10;Car loan: 9000"
        data-i18n-placeholder="tool.netWorth.liabilitiesPlaceholder"
      ></textarea>

      <div class="tool-options">
        <label class="tool-option">
          <input type="checkbox" id="opt-show-breakdown" checked />
          <span data-i18n="tool.netWorth.showBreakdown">Show breakdown</span>
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="16"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.netWorth.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

