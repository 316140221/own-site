---
layout: layouts/base.njk
title: "Image Watermark"
description: "Add a text watermark to images locally in your browser. Runs locally."
pageScript: "/assets/tools/image-watermark.js"
---

<h1 data-i18n="tools.item.image-watermark.title">Image Watermark</h1>


<section class="tool-shell">
  <div class="tool-pane">
    <label class="tool-label" for="tool-file" data-i18n="tool.imageWatermark.file">Image file</label>
    <input type="file" id="tool-file" class="tool-file" accept="image/*" />
    <p class="muted small" id="tool-file-meta"></p>
  </div>

  <div class="tool-options">
    <label class="tool-option">
      <span data-i18n="tool.imageWatermark.text">Watermark:</span>
      <input
        type="text"
        id="opt-text"
        class="tool-input-wide"
        placeholder="Watermark text…"
        data-i18n-placeholder="tool.imageWatermark.textPlaceholder"
      />
    </label>
    <label class="tool-option">
      <span data-i18n="tool.imageWatermark.position">Position:</span>
      <select id="opt-position">
        <option value="br" data-i18n="tool.imageWatermark.position.br">Bottom right</option>
        <option value="bl" data-i18n="tool.imageWatermark.position.bl">Bottom left</option>
        <option value="tr" data-i18n="tool.imageWatermark.position.tr">Top right</option>
        <option value="tl" data-i18n="tool.imageWatermark.position.tl">Top left</option>
        <option value="center" data-i18n="tool.imageWatermark.position.center">Center</option>
      </select>
    </label>
    <label class="tool-option">
      <span data-i18n="tool.imageWatermark.size">Font size:</span>
      <input type="number" id="opt-size" min="6" step="1" value="28" />
    </label>
    <label class="tool-option">
      <span data-i18n="tool.imageWatermark.opacity">Opacity:</span>
      <input type="number" id="opt-opacity" min="0.05" max="1" step="0.05" value="0.25" />
    </label>
    <label class="tool-option">
      <span data-i18n="tool.imageWatermark.color">Color:</span>
      <input type="text" id="opt-color" value="#ffffff" placeholder="#RRGGBB" />
    </label>
    <label class="tool-option">
      <span data-i18n="tool.imageWatermark.margin">Margin:</span>
      <input type="number" id="opt-margin" min="0" step="1" value="18" />
    </label>
    <label class="tool-option">
      <input type="checkbox" id="opt-outline" checked />
      <span data-i18n="tool.imageWatermark.outline">Outline</span>
    </label>
    <label class="tool-option">
      <span data-i18n="tool.imageWatermark.format">Format:</span>
      <select id="opt-format">
        <option value="keep" data-i18n="tool.imageWatermark.format.keep">Keep</option>
        <option value="jpeg" data-i18n="tool.imageWatermark.format.jpeg">JPEG</option>
        <option value="webp" data-i18n="tool.imageWatermark.format.webp">WebP</option>
        <option value="png" data-i18n="tool.imageWatermark.format.png">PNG</option>
      </select>
    </label>
    <label class="tool-option">
      <span data-i18n="tool.imageWatermark.maxWidth">Max width:</span>
      <input
        type="number"
        id="opt-max-width"
        min="1"
        step="1"
        placeholder="Auto"
        data-i18n-placeholder="tool.imageWatermark.autoPlaceholder"
      />
    </label>
    <label class="tool-option">
      <span data-i18n="tool.imageWatermark.maxHeight">Max height:</span>
      <input
        type="number"
        id="opt-max-height"
        min="1"
        step="1"
        placeholder="Auto"
        data-i18n-placeholder="tool.imageWatermark.autoPlaceholder"
      />
    </label>
    <label class="tool-option">
      <span data-i18n="tool.imageWatermark.quality">Quality:</span>
      <input type="number" id="opt-quality" min="0.05" max="1" step="0.05" value="0.85" />
    </label>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-run" data-i18n="tool.imageWatermark.run">Apply</button>
    <a
      class="button button-secondary"
      id="btn-download"
      href="#"
      download
      hidden
      data-i18n="tool.imageWatermark.download"
      >Download</a
    >
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">Clear</button>
  </div>

  <div class="tool-grid tool-preview-grid" aria-label="Preview">
    <div class="tool-pane">
      <div class="tool-label" data-i18n="tool.imageWatermark.original">Original</div>
      <div class="tool-preview-box">
        <img id="preview-original" class="tool-preview-img" alt="" loading="lazy" decoding="async" />
      </div>
      <p class="muted small" id="meta-original"></p>
    </div>
    <div class="tool-pane">
      <div class="tool-label" data-i18n="tool.imageWatermark.output">Output</div>
      <div class="tool-preview-box">
        <img id="preview-output" class="tool-preview-img" alt="" loading="lazy" decoding="async" />
      </div>
      <p class="muted small" id="meta-output"></p>
    </div>
  </div>

  <div class="tool-pane tool-pane-block">
    <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
    <textarea
      id="tool-output"
      class="tool-textarea"
      rows="7"
      readonly
      placeholder="Result will appear here…"
      data-i18n-placeholder="tool.common.resultPlaceholder"
      spellcheck="false"
    ></textarea>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

