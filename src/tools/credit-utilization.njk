---
layout: layouts/base.njk
title: "Credit Utilization Calculator"
description: "Calculate credit utilization per card and overall (balance ÷ limit). Runs locally."
pageScript: "/assets/tools/credit-utilization.js"
---

<h1 data-i18n="tools.item.credit-utilization.title">Credit Utilization Calculator</h1>
<p class="muted" data-i18n="tools.localNotice">Runs locally in your browser. Nothing is uploaded.</p>
<p class="muted small" data-i18n="tool.creditUtil.disclaimer">Estimates only. Not financial advice.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <label class="tool-label" for="opt-cards" data-i18n="tool.creditUtil.cards"
        >Cards (one per line: balance / limit)</label
      >
      <textarea
        id="opt-cards"
        class="tool-textarea"
        rows="10"
        autocomplete="off"
        spellcheck="false"
        placeholder="e.g.&#10;Chase: 1200 / 5000&#10;Amex: 0 / 8000"
        data-i18n-placeholder="tool.creditUtil.cardsPlaceholder"
      ></textarea>

      <div class="tool-options">
        <label class="tool-option">
          <input type="checkbox" id="opt-show-breakdown" checked />
          <span data-i18n="tool.creditUtil.showBreakdown">Show per-card breakdown</span>
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="16"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.creditUtil.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

