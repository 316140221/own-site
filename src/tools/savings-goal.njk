---
layout: layouts/base.njk
title: "Savings Goal Calculator"
description: "Estimate time to reach a savings goal or required monthly savings. Runs locally."
pageScript: "/assets/tools/savings-goal.js"
---

<h1 data-i18n="tools.item.savings-goal.title">Savings Goal Calculator</h1>

<p class="muted small" data-i18n="tool.savingsGoal.disclaimer">Estimates only. Not financial advice.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.savingsGoal.mode">Mode</span>
          <select id="opt-mode">
            <option value="time" data-i18n="tool.savingsGoal.mode.time">Time to goal</option>
            <option value="monthly" data-i18n="tool.savingsGoal.mode.monthly">Monthly savings needed</option>
          </select>
        </label>

        <label class="tool-option">
          <span data-i18n="tool.savingsGoal.start">Starting amount</span>
          <input
            type="text"
            id="opt-start"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="tool-input-wide"
            placeholder="e.g. 1000"
            data-i18n-placeholder="tool.savingsGoal.startPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.savingsGoal.goal">Goal amount</span>
          <input
            type="text"
            id="opt-goal"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="e.g. 20000"
            data-i18n-placeholder="tool.savingsGoal.goalPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.savingsGoal.monthly">Monthly savings</span>
          <input
            type="text"
            id="opt-monthly"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="e.g. 300"
            data-i18n-placeholder="tool.savingsGoal.monthlyPlaceholder"
          />
        </label>

        <div class="tool-option">
          <span data-i18n="tool.savingsGoal.targetTime">Target time</span>
          <div class="tool-inline">
            <input type="number" id="opt-years" min="0" max="100" step="1" value="5" />
            <span class="muted small" data-i18n="tool.savingsGoal.years">years</span>
            <input type="number" id="opt-months" min="0" max="11" step="1" value="0" />
            <span class="muted small" data-i18n="tool.savingsGoal.months">months</span>
          </div>
        </div>

        <label class="tool-option">
          <span data-i18n="tool.savingsGoal.rate">Interest rate (APY %) (optional)</span>
          <input type="number" id="opt-rate" min="0" max="100" step="0.01" value="4.00" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.savingsGoal.timing">Deposit timing</span>
          <select id="opt-timing">
            <option value="end" data-i18n="tool.savingsGoal.timing.end">End of month</option>
            <option value="start" data-i18n="tool.savingsGoal.timing.start">Start of month</option>
          </select>
        </label>

        <label class="tool-option">
          <input type="checkbox" id="opt-show-schedule" />
          <span data-i18n="tool.savingsGoal.showSchedule">Show first 12 months</span>
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="16"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.savingsGoal.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

