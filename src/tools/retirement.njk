---
layout: layouts/base.njk
title: "401(k) & Retirement Calculator"
description: "Estimate retirement savings growth with contributions and employer match. Runs locally."
pageScript: "/assets/tools/retirement.js"
---

<h1 data-i18n="tools.item.retirement.title">401(k) & Retirement Calculator</h1>

<p class="muted small" data-i18n="tool.retirement.disclaimer">Estimates only. Not financial advice.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.retirement.currentAge">Current age</span>
          <input type="number" id="opt-age" min="0" max="100" step="1" value="30" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.retirement.retireAge">Retirement age</span>
          <input type="number" id="opt-retire-age" min="0" max="120" step="1" value="65" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.retirement.balance">Current savings</span>
          <input
            type="text"
            id="opt-balance"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="tool-input-wide"
            placeholder="e.g. 20000"
            data-i18n-placeholder="tool.retirement.balancePlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.retirement.salary">Annual salary</span>
          <input
            type="text"
            id="opt-salary"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="e.g. 80000"
            data-i18n-placeholder="tool.retirement.salaryPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.retirement.employeePct">Your contribution %</span>
          <input type="number" id="opt-employee" min="0" max="100" step="0.1" value="10" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.retirement.matchRate">Employer match %</span>
          <input type="number" id="opt-match-rate" min="0" max="200" step="1" value="50" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.retirement.matchCap">Match up to % of salary</span>
          <input type="number" id="opt-match-cap" min="0" max="100" step="0.1" value="6" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.retirement.return">Annual return %</span>
          <input type="number" id="opt-return" min="0" max="50" step="0.1" value="7" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.retirement.growth">Salary growth %</span>
          <input type="number" id="opt-growth" min="0" max="20" step="0.1" value="3" />
        </label>

        <label class="tool-option">
          <input type="checkbox" id="opt-show-table" />
          <span data-i18n="tool.retirement.showTable">Show yearly breakdown</span>
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="18"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.retirement.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

