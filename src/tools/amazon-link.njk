---
layout: layouts/base.njk
title: "Amazon Affiliate Link Builder"
description: "Generate Amazon affiliate URLs and /go links locally. Runs locally."
pageScript: "/assets/tools/amazon-link.js"
---

<h1 data-i18n="tools.item.amazon-link.title">Amazon Affiliate Link Builder</h1>


<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <label class="tool-label" for="tool-input" data-i18n="tool.amazonLink.asin">ASIN</label>
      <textarea
        id="tool-input"
        class="tool-textarea"
        rows="2"
        placeholder="e.g. B08N5WRWNW"
        data-i18n-placeholder="tool.amazonLink.asinPlaceholder"
        spellcheck="false"
      ></textarea>

      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.amazonLink.title">Title:</span>
          <input
            class="tool-input-wide"
            type="text"
            id="opt-title"
            placeholder="Optional link text…"
            data-i18n-placeholder="tool.amazonLink.titlePlaceholder"
          />
        </label>
        <label class="tool-option">
          <span data-i18n="tool.amazonLink.domain">Domain:</span>
          <input type="text" id="opt-domain" value="{{ amazon.marketplace.domain }}" />
        </label>
        <label class="tool-option">
          <span data-i18n="tool.amazonLink.tag">Tag:</span>
          <input type="text" id="opt-tag" value="{{ amazon.associateTag or '' }}" />
        </label>
        <label class="tool-option">
          <span data-i18n="tool.amazonLink.format">Format:</span>
          <select id="opt-format">
            <option value="plain" data-i18n="tool.amazonLink.format.plain">Plain</option>
            <option value="markdown" data-i18n="tool.amazonLink.format.markdown">Markdown</option>
            <option value="html" data-i18n="tool.amazonLink.format.html">HTML</option>
          </select>
        </label>
      </div>

      <p class="muted small" data-i18n="tool.amazonLink.note.go">
        Note: “/go” only works for ASINs configured in your Shop list.
      </p>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="10"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-generate" data-i18n="tool.amazonLink.generate">
      Generate
    </button>
    <button class="button button-secondary" type="button" id="btn-open-go" data-i18n="tool.amazonLink.openGo">
      Open /go
    </button>
    <button
      class="button button-secondary"
      type="button"
      id="btn-open-amazon"
      data-i18n="tool.amazonLink.openAmazon"
    >
      Open Amazon
    </button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>
