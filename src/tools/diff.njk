---
layout: layouts/base.njk
title: "Text/JSON Diff"
description: "Compare two texts (or JSON) and generate a unified diff locally. Runs locally."
pageScript: "/assets/tools/diff.js"
---

<h1 data-i18n="tools.item.diff.title">Text/JSON Diff</h1>
<p class="muted" data-i18n="tools.localNotice">Runs locally in your browser. Nothing is uploaded.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <label class="tool-label" for="tool-left" data-i18n="tool.diff.left">Left</label>
      <textarea
        id="tool-left"
        class="tool-textarea"
        rows="10"
        placeholder="Paste left text…"
        data-i18n-placeholder="tool.diff.leftPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
    <div class="tool-pane">
      <label class="tool-label" for="tool-right" data-i18n="tool.diff.right">Right</label>
      <textarea
        id="tool-right"
        class="tool-textarea"
        rows="10"
        placeholder="Paste right text…"
        data-i18n-placeholder="tool.diff.rightPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-compare" data-i18n="tool.diff.compare">Compare</button>
    <button class="button button-secondary" type="button" id="btn-swap" data-i18n="tool.common.swap">
      Swap
    </button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">Clear</button>
  </div>

  <div class="tool-options">
    <label class="tool-option">
      <span data-i18n="tool.diff.mode">Mode:</span>
      <select id="opt-mode">
        <option value="auto" selected data-i18n="tool.diff.mode.auto">Auto</option>
        <option value="text" data-i18n="tool.diff.mode.text">Text</option>
        <option value="json" data-i18n="tool.diff.mode.json">JSON</option>
      </select>
    </label>
    <label class="tool-option">
      <input type="checkbox" id="opt-ignore-ws" />
      <span data-i18n="tool.diff.ignoreWs">Ignore whitespace</span>
    </label>
    <label class="tool-option">
      <input type="checkbox" id="opt-ignore-case" />
      <span data-i18n="tool.diff.ignoreCase">Ignore case</span>
    </label>
  </div>

  <div class="tool-pane tool-pane-block">
    <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
    <textarea
      id="tool-output"
      class="tool-textarea"
      rows="10"
      readonly
      placeholder="Result will appear here…"
      data-i18n-placeholder="tool.common.resultPlaceholder"
      spellcheck="false"
    ></textarea>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

