---
layout: layouts/base.njk
title: "Investment Fees Calculator"
description: "Estimate how investment fees (expense ratio) affect long-term growth. Runs locally."
pageScript: "/assets/tools/investment-fees.js"
---

<h1 data-i18n="tools.item.investment-fees.title">Investment Fees Calculator</h1>
<p class="muted" data-i18n="tools.localNotice">Runs locally in your browser. Nothing is uploaded.</p>
<p class="muted small" data-i18n="tool.investmentFees.disclaimer">Estimates only. Not financial advice.</p>

<section class="tool-shell">
  <div class="tool-grid">
    <div class="tool-pane">
      <div class="tool-options">
        <label class="tool-option">
          <span data-i18n="tool.investmentFees.principal">Initial amount</span>
          <input
            type="text"
            id="opt-principal"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            class="tool-input-wide"
            placeholder="e.g. 10000"
            data-i18n-placeholder="tool.investmentFees.principalPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.investmentFees.contribution">Contribution / month</span>
          <input
            type="text"
            id="opt-contribution"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            placeholder="e.g. 300"
            data-i18n-placeholder="tool.investmentFees.contributionPlaceholder"
          />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.investmentFees.return">Annual return % (before fees)</span>
          <input type="number" id="opt-return" min="0" max="50" step="0.1" value="7" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.investmentFees.fee">Annual fee % (expense ratio)</span>
          <input type="number" id="opt-fee" min="0" max="10" step="0.01" value="0.50" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.investmentFees.years">Years</span>
          <input type="number" id="opt-years" min="0" max="100" step="1" value="30" />
        </label>

        <label class="tool-option">
          <span data-i18n="tool.investmentFees.timing">Contribution timing</span>
          <select id="opt-timing">
            <option value="end" data-i18n="tool.investmentFees.timing.end">End of month</option>
            <option value="start" data-i18n="tool.investmentFees.timing.start">Start of month</option>
          </select>
        </label>

        <label class="tool-option">
          <input type="checkbox" id="opt-show-breakdown" />
          <span data-i18n="tool.investmentFees.showBreakdown">Show yearly breakdown</span>
        </label>
      </div>
    </div>

    <div class="tool-pane">
      <label class="tool-label" for="tool-output" data-i18n="tool.common.output">Output</label>
      <textarea
        id="tool-output"
        class="tool-textarea"
        rows="18"
        readonly
        placeholder="Result will appear here…"
        data-i18n-placeholder="tool.common.resultPlaceholder"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button class="button" type="button" id="btn-calc" data-i18n="tool.investmentFees.calculate">Calculate</button>
    <button class="button button-secondary" type="button" id="btn-copy" data-i18n="tool.common.copyOutput">
      Copy output
    </button>
    <button class="button button-secondary" type="button" id="btn-clear" data-i18n="tool.common.clear">
      Clear
    </button>
  </div>

  <p class="muted small" id="tool-status" role="status"></p>
</section>

