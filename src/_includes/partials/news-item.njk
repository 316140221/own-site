<li
  class="news-item"
  data-article-id="{{ item.id }}"
  data-article-title="{{ item.title | decodeEntities }}"
  data-article-category="{{ item.category }}"
  data-article-published-at="{{ item.publishedAt }}"
  data-article-source-name="{{ item.source.name }}"
  data-article-path="{{ ('/p/' + item.id + '/') | url }}"
>
  {% if item.image %}
    <a class="news-thumb" href="{{ ('/p/' + item.id + '/') | url }}" tabindex="-1" aria-hidden="true">
      <img
        src="{{ item.image }}"
        alt="{{ item.title | decodeEntities }}"
        width="140"
        height="92"
        loading="lazy"
        decoding="async"
      />
    </a>
  {% endif %}

  <div class="news-body">
    <div class="news-title">
      <a href="{{ ('/p/' + item.id + '/') | url }}">{{ item.title | decodeEntities }}</a>
    </div>
    <div class="news-meta">
      {% if item.category %}
        <a class="badge" href="{{ ('/category/' + item.category + '/') | url }}">{{ item.category | titleCase }}</a>
      {% endif %}
      {% if item.language %}
        <a class="badge" href="{{ ('/lang/' + item.language + '/') | url }}">{{ item.language | upper }}</a>
      {% endif %}
      {% if item.score %}
        <span class="badge badge-score" title="Quality score">{{ item.score }}</span>
      {% endif %}
      <span class="muted">{{ item.publishedAt | formatDateTime }}</span>
      <span class="muted">·</span>
      {% if item.source and item.source.id %}
        <a class="muted" href="{{ ('/source/' + item.source.id + '/') | url }}">{{ item.source.name }}</a>
      {% else %}
        <span class="muted">{{ item.source.name }}</span>
      {% endif %}
      <span class="muted">·</span>
      <a
        class="muted"
        href="{{ item.canonicalUrl }}"
        target="_blank"
        rel="nofollow noopener noreferrer"
        referrerpolicy="strict-origin-when-cross-origin"
        data-i18n="article.readOriginal"
      >
        Read original
      </a>
      <button
        class="tag-pill"
        type="button"
        data-favorite-article-card
        aria-pressed="false"
        data-i18n="article.save"
      >
        Save
      </button>
    </div>
    {% if item.summary %}
      <p class="news-summary">{{ item.summary }}</p>
    {% endif %}
  </div>
</li>
