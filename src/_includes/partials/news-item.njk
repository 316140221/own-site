<li
  class="news-item"
  data-article-id="{{ item.id }}"
  data-article-published="{{ item.publishedAt }}"
  data-article-score="{{ item.score or 0 }}"
  {% if item.source and item.source.id %}data-article-source-id="{{ item.source.id }}"{% endif %}
  {% if item.image %}data-article-has-image="1"{% endif %}
>
  {% if item.image %}
    <a class="news-thumb" href="{{ ('/p/' + item.id + '/') | url }}" tabindex="-1" aria-hidden="true">
      <img
        src="{{ item.image }}"
        alt="{{ item.title | decodeEntities }}"
        width="140"
        height="92"
        loading="lazy"
        decoding="async"
      />
    </a>
  {% endif %}

  <div class="news-body">
    <div class="news-title">
      <a href="{{ ('/p/' + item.id + '/') | url }}">{{ item.title | decodeEntities }}</a>
    </div>
    <div class="news-meta">
      {% if item.category %}
        <a class="badge" href="{{ ('/category/' + item.category + '/') | url }}">{{ item.category | titleCase }}</a>
      {% endif %}
      {% if item.language %}
        <a class="badge" href="{{ ('/lang/' + item.language + '/') | url }}">{{ item.language | upper }}</a>
      {% endif %}
      {% if item.score %}
        <span class="badge badge-score" title="Quality score">{{ item.score }}</span>
      {% endif %}
      <time class="muted" datetime="{{ item.publishedAt }}">{{ item.publishedAt | formatDateTime }}</time>
      {% if item.source and item.source.id %}
        <a class="muted" href="{{ ('/source/' + item.source.id + '/') | url }}" data-article-source>{{ item.source.name }}</a>
      {% else %}
        <span class="muted" data-article-source>{{ item.source.name }}</span>
      {% endif %}
      <a
        class="muted"
        href="{{ item.canonicalUrl }}"
        target="_blank"
        rel="nofollow noopener noreferrer"
        referrerpolicy="strict-origin-when-cross-origin"
        data-i18n="article.readOriginal"
      >
        Read original
      </a>
      <button
        class="tag-pill"
        type="button"
        data-favorite-article-card
        aria-pressed="false"
        data-i18n="article.save"
      >
        Save
      </button>
      <button
        class="tag-pill"
        type="button"
        data-article-read-card-toggle
        aria-pressed="false"
        data-i18n="article.markRead"
      >
        Mark read
      </button>
      <button class="tag-pill" type="button" data-copy-article-card data-i18n="article.copy">
        Copy link
      </button>
      <button class="tag-pill" type="button" data-share-article-card data-i18n="article.share">
        Share
      </button>
    </div>
    {% if item.summary %}
      <p class="news-summary">{{ item.summary | truncateText(200) }}</p>
    {% endif %}
  </div>
</li>
