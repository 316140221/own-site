{% if pagination and pagination.pages and pagination.pages.length > 1 %}
  <nav class="pager" aria-label="Pagination">
    {% if pagination.href.previous %}
      <a class="pager-link" href="{{ pagination.href.previous | url }}" rel="prev" data-i18n="pager.prev"
        >← Prev</a
      >
    {% else %}
      <span class="pager-disabled" aria-disabled="true" data-i18n="pager.prev">← Prev</span>
    {% endif %}

    <span
      class="pager-meta"
      data-i18n-template="pager.meta"
      data-i18n-vars='{{ { current: pagination.pageNumber + 1, total: pagination.pages.length } | jsonLd | safe }}'
    >
      Page {{ pagination.pageNumber + 1 }} / {{ pagination.pages.length }}
    </span>

    {% if pagination.href.next %}
      <a class="pager-link" href="{{ pagination.href.next | url }}" rel="next" data-i18n="pager.next"
        >Next →</a
      >
    {% else %}
      <span class="pager-disabled" aria-disabled="true" data-i18n="pager.next">Next →</span>
    {% endif %}
  </nav>
{% endif %}
