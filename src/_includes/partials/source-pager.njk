{% set base = '/source/' + sourcePage.id + '/' %}
<nav class="pager">
  {% if sourcePage.pageNumber > 0 %}
    {% set prevPage = sourcePage.pageNumber - 1 %}
    {% if prevPage == 0 %}
      <a class="pager-link" href="{{ base | url }}" rel="prev">← Prev</a>
    {% else %}
      <a class="pager-link" href="{{ (base + 'page/' + (prevPage + 1) + '/') | url }}" rel="prev"
        >← Prev</a
      >
    {% endif %}
  {% else %}
    <span class="pager-disabled">← Prev</span>
  {% endif %}

  <span class="pager-meta">
    Page {{ sourcePage.pageNumber + 1 }} / {{ sourcePage.totalPages }}
  </span>

  {% if sourcePage.pageNumber + 1 < sourcePage.totalPages %}
    {% set nextPage = sourcePage.pageNumber + 1 %}
    <a class="pager-link" href="{{ (base + 'page/' + (nextPage + 1) + '/') | url }}" rel="next"
      >Next →</a
    >
  {% else %}
    <span class="pager-disabled">Next →</span>
  {% endif %}
</nav>
