{% set base = '/source/' + sourcePage.id + '/' %}
<nav class="pager" aria-label="Pagination">
  {% if sourcePage.pageNumber > 0 %}
    {% set prevPage = sourcePage.pageNumber - 1 %}
    {% if prevPage == 0 %}
      <a class="pager-link" href="{{ base | url }}" rel="prev" data-i18n="pager.prev">← Prev</a>
    {% else %}
      <a
        class="pager-link"
        href="{{ (base + 'page/' + (prevPage + 1) + '/') | url }}"
        rel="prev"
        data-i18n="pager.prev"
      >
        ← Prev
      </a>
    {% endif %}
  {% else %}
    <span class="pager-disabled" aria-disabled="true" data-i18n="pager.prev">← Prev</span>
  {% endif %}

  <span
    class="pager-meta"
    data-i18n-template="pager.meta"
    data-i18n-vars='{{ { current: sourcePage.pageNumber + 1, total: sourcePage.totalPages } | jsonLd | safe }}'
  >
    Page {{ sourcePage.pageNumber + 1 }} / {{ sourcePage.totalPages }}
  </span>

  {% if sourcePage.pageNumber + 1 < sourcePage.totalPages %}
    {% set nextPage = sourcePage.pageNumber + 1 %}
    <a
      class="pager-link"
      href="{{ (base + 'page/' + (nextPage + 1) + '/') | url }}"
      rel="next"
      data-i18n="pager.next"
    >
      Next →
    </a>
  {% else %}
    <span class="pager-disabled" aria-disabled="true" data-i18n="pager.next">Next →</span>
  {% endif %}
</nav>
