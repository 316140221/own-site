<article class="article">
  <script type="application/json" data-article-meta>
    {{
      {
        id: entry.id,
        title: article.title,
        category: article.category,
        publishedAt: article.publishedAt,
        sourceName: article.source.name,
        path: page.url | url
      }
        | jsonLd
        | safe
    }}
  </script>
  <div class="article-header">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ '/' | url }}" data-i18n="breadcrumbs.home">Home</a>
      {% if article.category %}
        <span class="breadcrumbs-sep" aria-hidden="true">›</span>
        <a href="{{ ('/category/' + article.category + '/') | url }}">{{ article.category | titleCase }}</a>
      {% endif %}
      <span class="breadcrumbs-sep" aria-hidden="true">›</span>
      <span class="breadcrumbs-current">{{ article.title | decodeEntities }}</span>
    </nav>
    <h1 class="article-title">{{ article.title | decodeEntities }}</h1>
    <div class="article-meta">
      {% if article.category %}
        <a class="badge" href="{{ ('/category/' + article.category + '/') | url }}">{{ article.category | titleCase }}</a>
      {% endif %}
      {% if article.language %}
        <a class="badge" href="{{ ('/lang/' + article.language + '/') | url }}">{{ article.language | upper }}</a>
      {% endif %}
      <span class="muted">{{ article.publishedAt | formatDateTime }}</span>
      <span class="muted">·</span>
      {% if article.source and article.source.url %}
        <a
          class="muted"
          href="{{ article.source.url }}"
          target="_blank"
          rel="noopener noreferrer"
          >{{ article.source.name }}</a
        >
      {% else %}
        <span class="muted">{{ article.source.name }}</span>
      {% endif %}
      <span class="muted">·</span>
      <a
        href="{{ article.canonicalUrl }}"
        target="_blank"
        rel="noopener noreferrer"
        data-i18n="article.readOriginal"
      >
        Read original
      </a>
    </div>
  </div>

  {% if article.image %}
    <div class="article-image">
      <img
        src="{{ article.image }}"
        alt="{{ article.title | decodeEntities }}"
        width="1200"
        height="675"
        loading="lazy"
        decoding="async"
      />
    </div>
  {% endif %}

  {% if article.summary %}
    <p class="article-summary">{{ article.summary }}</p>
  {% endif %}

  {% if article.contentText %}
    {% set excerptLimit = 1600 %}
    {% set contentExcerpt = article.contentText | truncateText(excerptLimit) %}
    <section class="article-content">
      <h2 class="article-content-title" data-i18n="article.fromRss">From RSS</h2>
      <div class="muted small" data-i18n="article.fromRssNote">
        Long content extracted from the source RSS feed. For the official version, use “Open original”.
      </div>
      <div class="article-content-body">{{ contentExcerpt | textToHtml | safe }}</div>
    </section>
  {% endif %}

  <div class="article-actions">
    <a
      class="button"
      href="{{ article.canonicalUrl }}"
      target="_blank"
      rel="noopener noreferrer"
      data-i18n="article.openOriginal"
    >
      Open original →
    </a>
    <button class="button button-secondary" type="button" data-share-link data-i18n="article.share">
      Share
    </button>
    <button class="button button-secondary" type="button" data-copy-link data-i18n="article.copy">
      Copy link
    </button>
    <button
      class="button button-secondary"
      type="button"
      data-favorite-article
      data-i18n="article.save"
      aria-pressed="false"
    >
      Save
    </button>
    <a class="button button-secondary" href="{{ ('/category/' + article.category + '/') | url }}">
      <span data-i18n="article.moreIn">More in</span> {{ article.category | titleCase }}
    </a>
  </div>

  {% if relatedArticles and relatedArticles.length %}
    <section class="article-related">
      <h2 class="article-related-title" data-i18n="article.related">Recommended</h2>
      <ul class="article-related-list">
        {% for rec in relatedArticles %}
          <li class="article-related-item">
            <a href="{{ ('/p/' + rec.id + '/') | url }}">{{ rec.title | decodeEntities }}</a>
            {% if rec.publishedAt %}
              <span class="muted small">· {{ rec.publishedAt | formatDate }}</span>
            {% endif %}
            {% if rec.sourceName %}
              <span class="muted small">· {{ rec.sourceName }}</span>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}
</article>
