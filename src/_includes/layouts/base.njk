<!doctype html>
{% set pageLang = site.language %}
{% if langPage and langPage.code %}
  {% set pageLang = langPage.code %}
{% endif %}
{% if article and article.language %}
  {% set pageLang = article.language %}
{% endif %}
<html
  lang="{{ pageLang }}"
  data-default-lang="{{ site.defaultLanguage }}"
  data-supported-langs="{{ site.languagesCsv }}"
>
  <head>
	    <meta charset="utf-8" />
	    <meta name="viewport" content="width=device-width, initial-scale=1" />
	    <meta name="referrer" content="strict-origin-when-cross-origin" />
	    <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml" />
	    <meta name="theme-color" content="#0284c7" />

    {% set metaTitle = site.name %}
    {% if title %}
      {% set metaTitle = (title | decodeEntities) + ' · ' + site.name %}
    {% endif %}
    {% set metaDescription = description or site.description %}
    {% set canonical = (page.url | url) | absoluteUrl(site.url) %}

    {% set contentLang = pageLang %}

    {% set ogImage = "" %}
    {% if article and article.image %}
      {% set ogImage = article.image %}
    {% endif %}

    {% set robotsContent = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1' %}
    {% if metaRobots is defined and metaRobots %}
      {% set robotsContent = metaRobots %}
    {% endif %}

    <title>{{ metaTitle }}</title>
    <meta name="description" content="{{ metaDescription }}" />
    <meta name="robots" content="{{ robotsContent }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    {% if site.googleSiteVerification %}
      <meta name="google-site-verification" content="{{ site.googleSiteVerification }}" />
    {% endif %}

    <link rel="canonical" href="{{ canonical }}" />
    {% set headPrevPath = null %}
    {% set headNextPath = null %}

    {% if listPage and (listPage.pageNumber is defined) and (listPage.totalPages is defined) %}
      {% if listPage.pageNumber > 0 %}
        {% set prevPage = listPage.pageNumber - 1 %}
        {% set headPrevPath = '/page/' + (prevPage + 1) + '/' %}
      {% endif %}

      {% if listPage.pageNumber + 1 < listPage.totalPages %}
        {% set nextPage = listPage.pageNumber + 1 %}
        {% set headNextPath = '/page/' + (nextPage + 1) + '/' %}
      {% endif %}
    {% elif catPage and catPage.slug and (catPage.pageNumber is defined) and (catPage.totalPages is defined) %}
      {% set base = '/category/' + catPage.slug + '/' %}
      {% if catPage.pageNumber > 0 %}
        {% set prevPage = catPage.pageNumber - 1 %}
        {% if prevPage == 0 %}
          {% set headPrevPath = base %}
        {% else %}
          {% set headPrevPath = base + 'page/' + (prevPage + 1) + '/' %}
        {% endif %}
      {% endif %}
      {% if catPage.pageNumber + 1 < catPage.totalPages %}
        {% set nextPage = catPage.pageNumber + 1 %}
        {% set headNextPath = base + 'page/' + (nextPage + 1) + '/' %}
      {% endif %}
    {% elif langPage and langPage.code and (langPage.pageNumber is defined) and (langPage.totalPages is defined) %}
      {% set base = '/lang/' + langPage.code + '/' %}
      {% if langPage.pageNumber > 0 %}
        {% set prevPage = langPage.pageNumber - 1 %}
        {% if prevPage == 0 %}
          {% set headPrevPath = base %}
        {% else %}
          {% set headPrevPath = base + 'page/' + (prevPage + 1) + '/' %}
        {% endif %}
      {% endif %}
      {% if langPage.pageNumber + 1 < langPage.totalPages %}
        {% set nextPage = langPage.pageNumber + 1 %}
        {% set headNextPath = base + 'page/' + (nextPage + 1) + '/' %}
      {% endif %}
    {% elif sourcePage and sourcePage.id and (sourcePage.pageNumber is defined) and (sourcePage.totalPages is defined) %}
      {% set base = '/source/' + sourcePage.id + '/' %}
      {% if sourcePage.pageNumber > 0 %}
        {% set prevPage = sourcePage.pageNumber - 1 %}
        {% if prevPage == 0 %}
          {% set headPrevPath = base %}
        {% else %}
          {% set headPrevPath = base + 'page/' + (prevPage + 1) + '/' %}
        {% endif %}
      {% endif %}
      {% if sourcePage.pageNumber + 1 < sourcePage.totalPages %}
        {% set nextPage = sourcePage.pageNumber + 1 %}
        {% set headNextPath = base + 'page/' + (nextPage + 1) + '/' %}
      {% endif %}
    {% endif %}

    {% if headPrevPath %}
      <link rel="prev" href="{{ headPrevPath | url | absoluteUrl(site.url) }}" />
    {% endif %}
    {% if headNextPath %}
      <link rel="next" href="{{ headNextPath | url | absoluteUrl(site.url) }}" />
    {% endif %}
    <meta property="og:url" content="{{ canonical }}" />
    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:title" content="{{ metaTitle }}" />
    <meta property="og:description" content="{{ metaDescription }}" />

    {% if ogImage %}
      {% set ogImageAbs = ogImage | absoluteUrl(site.url) %}
      <meta property="og:image" content="{{ ogImageAbs }}" />
      <meta property="og:image:alt" content="{{ title | decodeEntities if title else site.name }}" />
    {% endif %}

    {% if ogType == 'article' and article %}
      {% set articleModifiedAt = article.fetchedAt or article.publishedAt %}
      {% if article.publishedAt %}
        <meta property="article:published_time" content="{{ article.publishedAt }}" />
        <meta property="article:modified_time" content="{{ articleModifiedAt }}" />
      {% endif %}
      {% if article.category %}
        <meta property="article:section" content="{{ article.category | titleCase }}" />
      {% endif %}
      {% if article.tags and article.tags.length %}
        {% for tag in article.tags | cleanTags(10) %}
          <meta property="article:tag" content="{{ tag | decodeEntities }}" />
        {% endfor %}
      {% endif %}
    {% endif %}

    <meta name="twitter:card" content="{% if ogImage %}summary_large_image{% else %}summary{% endif %}" />
    <meta name="twitter:title" content="{{ metaTitle }}" />
    <meta name="twitter:description" content="{{ metaDescription }}" />
    <meta name="twitter:url" content="{{ canonical }}" />
    {% if ogImage %}
      <meta name="twitter:image" content="{{ ogImageAbs }}" />
    {% endif %}

    {% set schemaOrgId = site.url + '#organization' %}
    {% set schemaWebsiteId = site.url + '#website' %}
    {% set schemaWebpageId = canonical + '#webpage' %}
    {% set schemaGraph = [
      {
        '@type': 'Organization',
        '@id': schemaOrgId,
        'name': site.name,
        'url': site.url
      },
      {
        '@type': 'WebSite',
        '@id': schemaWebsiteId,
        'url': site.url,
        'name': site.name,
        'description': site.description,
        'publisher': { '@id': schemaOrgId },
        'potentialAction': {
          '@type': 'SearchAction',
          'target': {
            '@type': 'EntryPoint',
            'urlTemplate': site.url + '/search/?q={search_term_string}'
          },
          'query-input': 'required name=search_term_string'
        }
      },
      {
        '@type': 'WebPage',
        '@id': schemaWebpageId,
        'url': canonical,
        'name': metaTitle,
        'description': metaDescription,
        'isPartOf': { '@id': schemaWebsiteId },
        'inLanguage': contentLang
      }
    ] %}

    {% if ogType == 'article' and article %}
      {% set categoryUrl = ('/category/' + article.category + '/') | url | absoluteUrl(site.url) %}
      {% set breadcrumbId = canonical + '#breadcrumb' %}
      {% set homeUrl = ('/' | url | absoluteUrl(site.url)) %}
      {% set categoryLabel = article.category | titleCase %}
      {% set articleTitle = article.title | decodeEntities %}
      {% set schemaImage = undefined %}
      {% if ogImage %}
        {% set schemaImage = ogImageAbs %}
      {% endif %}
      {% set articleModifiedAt = article.fetchedAt or article.publishedAt %}
      {% set schemaKeywords = undefined %}
      {% if article.tags and article.tags.length %}
        {% set cleanedTags = (article.tags | cleanTags(20)) %}
        {% if cleanedTags and cleanedTags.length %}
          {% set schemaKeywords = (cleanedTags | join(', ')) %}
        {% endif %}
      {% endif %}
      {% set publisherName = '' %}
      {% set publisherUrl = undefined %}
      {% if article.source and article.source.name %}
        {% set publisherName = article.source.name %}
      {% endif %}
      {% if article.source and article.source.url %}
        {% set publisherUrl = article.source.url %}
      {% endif %}
      {% set publisherId = schemaOrgId %}
      {% set extraSchemaNodes = [] %}
      {% if publisherName %}
        {% set publisherId = canonical + '#publisher' %}
        {% set extraSchemaNodes = extraSchemaNodes.concat([
          {
            '@type': 'Organization',
            '@id': publisherId,
            'name': publisherName,
            'url': publisherUrl
          }
        ]) %}
      {% endif %}
      {% set schemaGraph = schemaGraph.concat(extraSchemaNodes).concat([
        {
          '@type': 'BreadcrumbList',
          '@id': breadcrumbId,
          'itemListElement': [
            { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': homeUrl },
            { '@type': 'ListItem', 'position': 2, 'name': categoryLabel, 'item': categoryUrl },
            { '@type': 'ListItem', 'position': 3, 'name': articleTitle, 'item': canonical }
          ]
        },
        {
          '@type': 'Article',
          '@id': canonical + '#article',
          'headline': articleTitle,
          'description': (article.summary or metaDescription),
          'datePublished': article.publishedAt,
          'dateModified': articleModifiedAt,
          'inLanguage': contentLang,
          'isBasedOn': article.canonicalUrl,
          'url': canonical,
          'mainEntityOfPage': { '@id': schemaWebpageId },
          'publisher': { '@id': publisherId },
          'articleSection': categoryLabel,
          'keywords': schemaKeywords,
          'image': schemaImage
        }
      ]) %}
    {% endif %}

    {% set isToolPage = page.url and page.url.startsWith('/tools/') and page.url != '/tools/' %}
    {% if isToolPage %}
      {% set toolTitle = title | decodeEntities if title else metaTitle %}
      {% set toolBreadcrumbId = canonical + '#breadcrumb' %}
      {% set homeUrl = ('/' | url | absoluteUrl(site.url)) %}
      {% set toolsUrl = ('/tools/' | url | absoluteUrl(site.url)) %}

      {% set schemaGraph = schemaGraph.concat([
        {
          '@type': 'BreadcrumbList',
          '@id': toolBreadcrumbId,
          'itemListElement': [
            { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': homeUrl },
            { '@type': 'ListItem', 'position': 2, 'name': 'Tools', 'item': toolsUrl },
            { '@type': 'ListItem', 'position': 3, 'name': toolTitle, 'item': canonical }
          ]
        },
        {
          '@type': 'WebApplication',
          '@id': canonical + '#app',
          'name': toolTitle,
          'url': canonical,
          'description': metaDescription,
          'applicationCategory': 'UtilitiesApplication',
          'operatingSystem': 'All',
          'isAccessibleForFree': true,
          'inLanguage': contentLang,
          'publisher': { '@id': schemaOrgId },
          'mainEntityOfPage': { '@id': schemaWebpageId }
        }
      ]) %}
    {% endif %}

    {% set schemaItemListElements = [] %}
    {% set schemaItemListItems = null %}
    {% set schemaItemListName = null %}
    {% if listPage and listPage.items and listPage.items.length %}
      {% set schemaItemListItems = listPage.items %}
      {% set schemaItemListName = 'Latest' %}
    {% elif catPage and catPage.items and catPage.items.length %}
      {% set schemaItemListItems = catPage.items %}
      {% set schemaItemListName = catPage.label %}
    {% elif langPage and langPage.items and langPage.items.length %}
      {% set schemaItemListItems = langPage.items %}
      {% set schemaItemListName = langPage.label %}
    {% elif sourcePage and sourcePage.items and sourcePage.items.length %}
      {% set schemaItemListItems = sourcePage.items %}
      {% set schemaItemListName = sourcePage.name %}
    {% endif %}

    {% if schemaItemListItems and schemaItemListItems.length %}
      {% set schemaItemListId = canonical + '#itemlist' %}
      {% set schemaItemListElements = schemaItemListItems | toItemListElements(site.url, 10) %}
      {% set schemaGraph = schemaGraph.concat([
        {
          '@type': 'ItemList',
          '@id': schemaItemListId,
          'name': schemaItemListName or metaTitle,
          'url': canonical,
          'mainEntityOfPage': { '@id': schemaWebpageId },
          'itemListOrder': 'https://schema.org/ItemListOrderDescending',
          'numberOfItems': schemaItemListItems.length,
          'itemListElement': schemaItemListElements
        }
      ]) %}
    {% endif %}
    <script type="application/ld+json">{{ { '@context': 'https://schema.org', '@graph': schemaGraph } | jsonLd | safe }}</script>

    {% set rssTitle = site.name + ' RSS' %}
    {% if catPage and catPage.label %}
      {% set rssTitle = site.name + ' - ' + catPage.label %}
    {% elif langPage and langPage.label %}
      {% set rssTitle = site.name + ' - ' + langPage.label %}
    {% elif sourcePage and sourcePage.name %}
      {% set rssTitle = site.name + ' - ' + sourcePage.name %}
    {% endif %}

    <link
      rel="alternate"
      type="application/rss+xml"
      title="{{ rssTitle }}"
      href="{{ (rssPath or '/feed.xml') | url }}"
    />

    <script>
      (function () {
        try {
          var value = localStorage.getItem("site_theme");
          if (value === "light" || value === "dark") {
            document.documentElement.setAttribute("data-theme", value);
          }
        } catch (_e) {}
      })();
    </script>

    <link rel="stylesheet" href="{{ '/assets/style.css' | url }}" />
    <script src="{{ '/assets/app.js' | url }}" defer></script>
    {% if pageScript %}
      <script src="{{ pageScript | url }}" defer></script>
    {% endif %}
    {% include "partials/analytics.njk" %}
  </head>
  <body>
    {% set headerSearchEnabled = true %}
    {% if showHeaderSearch is defined %}
      {% set headerSearchEnabled = showHeaderSearch %}
    {% endif %}

    {% set headerNavModeResolved = 'full' %}
    {% if headerNavMode is defined and headerNavMode %}
      {% set headerNavModeResolved = headerNavMode %}
    {% endif %}

    {% set showNewsNavResolved = true %}
    {% if showNewsNav is defined %}
      {% set showNewsNavResolved = showNewsNav %}
    {% endif %}

    <a class="skip-link" href="#main-content" data-i18n="nav.skip">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="{{ '/' | url }}">{{ site.brand or site.name }}</a>
        <button
          class="menu-toggle"
          type="button"
          aria-controls="site-nav"
          aria-expanded="false"
          data-i18n="nav.menu"
        >
          Menu
        </button>
        {% if headerSearchEnabled %}
          <form
            class="header-search"
            action="{{ '/search/' | url }}"
            method="get"
            role="search"
            data-header-search
          >
            <label class="sr-only" for="site-search-q" data-i18n="search.label">Search</label>
            <input
              id="site-search-q"
              class="header-search-input"
              type="search"
              name="q"
              autocomplete="off"
              data-header-search-input
              data-i18n-placeholder="search.placeholder"
              placeholder="Search…"
            />
            <button class="header-search-btn" type="submit" data-i18n="search.go">Go</button>
          </form>
        {% endif %}
        <nav class="nav" id="site-nav">
          <a href="{{ '/' | url }}" data-i18n="nav.home">Home</a>

          {% if amazon and amazon.enabled %}
            <a href="{{ '/shop/' | url }}" data-i18n="nav.shop">Shop</a>
          {% endif %}

          {% if tools and tools.groups %}
            {% if headerNavModeResolved == 'minimal' %}
              <a href="{{ '/tools/' | url }}" data-i18n="nav.tools">Tools</a>
            {% else %}
              <details class="nav-dropdown" data-nav-section="tools">
                <summary data-i18n="nav.tools">Tools</summary>
                <div class="nav-dropdown-menu">
                  <a class="nav-dropdown-top" href="{{ '/tools/' | url }}" data-i18n="nav.toolsAll"
                    >All tools</a
                  >
                  {% for group in tools.groups %}
                    <div class="nav-dropdown-group">
                      <div class="nav-dropdown-title" data-i18n="tools.group.{{ group.id }}">
                        {{ group.label }}
                      </div>
                      {% for t in group.items %}
                        <a href="{{ t.path | url }}" data-i18n="tools.item.{{ t.slug }}.title"
                          >{{ t.label }}</a
                        >
                      {% endfor %}
                    </div>
                  {% endfor %}
                </div>
              </details>
            {% endif %}
          {% endif %}

          {% if showNewsNavResolved and categories %}
            {% if headerNavModeResolved == 'minimal' %}
              <a href="{{ '/page/1/' | url }}" data-i18n="home.latest">Latest</a>
              <a href="{{ '/trending/' | url }}" data-i18n="nav.trending">Trending</a>
            {% else %}
              <details class="nav-dropdown" data-nav-section="news">
                <summary data-i18n="nav.news">News</summary>
                <div class="nav-dropdown-menu">
                  <a class="nav-dropdown-top" href="{{ '/page/1/' | url }}" data-i18n="home.latest">Latest</a>
                  <a class="nav-dropdown-top" href="{{ '/trending/' | url }}" data-i18n="nav.trending">Trending</a>
                  {% for cat in categories %}
                    <a href="{{ ('/category/' + cat.slug + '/') | url }}">{{ cat.label }}</a>
                  {% endfor %}
                </div>
              </details>
            {% endif %}
          {% endif %}

          {% if site.languages and site.languages.length > 1 %}
            <details class="nav-dropdown nav-lang">
              <summary data-i18n="nav.language">Language</summary>
              <div class="nav-dropdown-menu">
                {% for langCode in site.languages %}
                  <button
                    class="nav-lang-btn"
                    type="button"
                    data-set-lang="{{ langCode }}"
                  >
                    {{ site.languageLabels[langCode] or langCode }}
                  </button>
                {% endfor %}
              </div>
            </details>
          {% endif %}

          <details class="nav-dropdown nav-theme">
            <summary data-i18n="nav.theme">Theme</summary>
            <div class="nav-dropdown-menu">
              <button class="nav-lang-btn" type="button" data-set-theme="auto" data-i18n="theme.auto">
                Auto
              </button>
              <button
                class="nav-lang-btn"
                type="button"
                data-set-theme="light"
                data-i18n="theme.light"
              >
                Light
              </button>
              <button class="nav-lang-btn" type="button" data-set-theme="dark" data-i18n="theme.dark">
                Dark
              </button>
            </div>
          </details>

          <a href="{{ '/library/' | url }}" data-i18n="nav.library">Library</a>
          {% if not headerSearchEnabled %}
            <a href="{{ '/search/' | url }}" data-i18n="nav.search">Search</a>
          {% endif %}
        </nav>
      </div>
	    </header>

	    {% set pagefindBodyEnabled = true %}
	    {% if pagefindBody is defined %}
	      {% set pagefindBodyEnabled = pagefindBody %}
	    {% endif %}

	    <main class="container" {% if pagefindBodyEnabled %}data-pagefind-body{% endif %} id="main-content">
	      {% include "partials/tool-nav.njk" %}
	      {{ content | safe }}
	      {% include "partials/tool-related.njk" %}
	    </main>

	    <button class="to-top button" type="button" data-to-top hidden data-i18n="nav.top">
	      Back to top
	    </button>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>
          {{ site.brand or site.name }} · {{ site.tagline or 'RSS stream' }} ·
          {{ (buildTime or '') | formatDateTime }}
        </span>
        <div class="footer-links">
          <a class="footer-link" href="{{ '/about/' | url }}" data-i18n="nav.about">About</a>
          <a class="footer-link" href="{{ '/privacy/' | url }}" data-i18n="nav.privacy">Privacy</a>
          <a
            class="footer-link"
            href="{{ '/affiliate-disclosure/' | url }}"
            data-i18n="nav.disclosure"
            >Affiliate Disclosure</a
          >
          <a class="footer-link" href="{{ '/contact/' | url }}" data-i18n="nav.contact">Contact</a>
          <a class="footer-link" href="{{ '/terms/' | url }}" data-i18n="nav.terms">Terms</a>
          <a class="footer-link" href="{{ '/feed.xml' | url }}" data-i18n="nav.rss">RSS</a>
          <a class="footer-link" href="{{ '/library/' | url }}" data-i18n="nav.library">Library</a>
        </div>
      </div>
    </footer>
  </body>
</html>
