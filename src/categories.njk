---
layout: layouts/base.njk
title: Categories
description: Browse stories by category
rssPath: /feed.xml
---

<h1 data-i18n="nav.categories">Categories</h1>

<p class="muted">
  <a href="{{ '/page/1/' | url }}" data-i18n="home.latest">Latest</a>
  · <a href="{{ '/trending/' | url }}" data-i18n="nav.trending">Trending</a>
</p>

<section class="list-controls" data-list-filter="categories">
  <div class="list-controls-filter" role="search" aria-label="Category filter">
    <label class="sr-only" for="categories-filter-q" data-i18n="categories.filterLabel">
      Filter categories
    </label>
    <input
      id="categories-filter-q"
      class="tools-filter-input"
      type="search"
      autocomplete="off"
      spellcheck="false"
      data-list-filter-input
      data-i18n-placeholder="categories.filterPlaceholder"
      placeholder="Filter categories…"
    />
    <button
      class="button button-secondary tools-filter-clear"
      type="button"
      data-list-filter-clear
      data-i18n="tools.filter.clear"
    >
      Clear
    </button>
  </div>
  <p class="muted small tools-filter-status" data-list-filter-status hidden></p>
  <p class="muted tools-filter-empty" data-list-filter-empty hidden data-i18n="categories.filterEmpty">
    No categories match this filter.
  </p>
</section>

{% if categoriesOverview and categoriesOverview.length %}
  <ul class="sources">
    {% for cat in categoriesOverview %}
      <li>
        <a href="{{ ('/category/' + cat.slug + '/') | url }}">{{ cat.label }}</a>
        <span class="muted">({{ cat.slug }})</span>
        <span
          class="muted"
          data-i18n-template="categories.count"
          data-i18n-vars='{{ { count: cat.count } | jsonLd | safe }}'
        >
          {{ cat.count }} articles
        </span>
        <span class="muted">
          · <a class="muted" href="{{ ('/category/' + cat.slug + '/feed.xml') | url }}">RSS</a>
          · <a class="muted" href="{{ ('/category/' + cat.slug + '/feed.json') | url }}">JSON</a>
        </span>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p class="muted" data-i18n="categories.empty">No categories available.</p>
{% endif %}

