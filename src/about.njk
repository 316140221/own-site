---
layout: layouts/base.njk
title: About
description: About this site and its sources
rssPath: /feed.xml
---

<h1 data-i18n="nav.about">About</h1>

<p>
  {{ site.brand or site.name }} is a cloud-ready collection of handy utilities plus a lightweight
  info stream. It’s designed to be usable anywhere — open and use, with minimal friction.
</p>

<p>
  The feed section republishes metadata (title, short summary) and links to original sources. Copyright
  belongs to the original publishers.
</p>

<p>
  <strong data-i18n="about.links">Links:</strong>
  <a href="{{ '/feed.xml' | url }}">RSS</a>
  · <a href="{{ '/sources/' | url }}">Sources</a>
  · <a href="{{ '/sources.opml' | url }}">OPML</a>
  · <a href="{{ '/runs/' | url }}">Runs</a>
  · <a href="{{ '/trending/' | url }}">Trending</a>
  · <a href="{{ '/languages/' | url }}">Languages</a>
  · <a href="{{ '/contact/' | url }}">Contact</a>
  · <a href="{{ '/terms/' | url }}">Terms</a>
  · <a href="{{ '/privacy/' | url }}">Privacy</a>
  · <a href="{{ '/affiliate-disclosure/' | url }}">Affiliate Disclosure</a>
  · <a href="{{ '/takedown/' | url }}">Takedown</a>
  {% if amazon and amazon.enabled %}· <a href="{{ '/shop/' | url }}">Shop</a>{% endif %}
</p>

<p class="muted">
  This site may contain affiliate links. See <a href="{{ '/affiliate-disclosure/' | url }}">Affiliate Disclosure</a>.
</p>

{% if stats %}
  <h2 data-i18n="about.status">Status</h2>
  <ul>
    <li><strong data-i18n="about.lastRun">Last run:</strong> {{ stats.finishedAt | formatDateTime }}</li>
    <li>
      <strong data-i18n="about.sourcesStat">Sources:</strong>
      <span
        data-i18n-template="about.sourcesStatValue"
        data-i18n-vars='{{ { ok: stats.fetch.ok, failed: stats.fetch.failed, paused: stats.fetch.paused or 0 } | jsonLd | safe }}'
      >
        {{ stats.fetch.ok }} OK / {{ stats.fetch.failed }} failed / {{ stats.fetch.paused or 0 }} paused
      </span>
    </li>
    <li><strong data-i18n="about.articlesStat">Articles:</strong> {{ stats.indexes.totalArticles }} (90-day retention)</li>
  </ul>
{% endif %}

<h2 data-i18n="sources.title">Sources</h2>
{% if sources and sources.length %}
  <ul class="sources">
    {% for s in sources %}
      <li>
        <strong>{{ s.name }}</strong>
        {% if s.siteUrl %}· <a href="{{ s.siteUrl }}" target="_blank" rel="noopener noreferrer">{{ s.siteUrl }}</a>{% endif %}
        {% if s.feedUrl %}· <a href="{{ s.feedUrl }}" target="_blank" rel="noopener noreferrer">RSS</a>{% endif %}
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p class="muted" data-i18n="about.noSources">No sources configured yet.</p>
{% endif %}
