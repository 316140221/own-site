---
layout: layouts/base.njk
title: Search
showHeaderSearch: false
metaRobots: "noindex,follow"
---

<h1 data-i18n="search.title">Search</h1>

<p class="muted" data-search-notice hidden role="status" aria-live="polite" data-i18n="search.notice">
  Search is temporarily unavailable.
</p>

<link rel="stylesheet" href="{{ '/pagefind/pagefind-ui.css' | url }}" />
<script src="{{ '/pagefind/pagefind-ui.js' | url }}" defer></script>

<div id="search"></div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const notice = document.querySelector("[data-search-notice]");
    if (!window.PagefindUI) {
      if (notice) notice.hidden = false;
      return;
    }
    if (notice) notice.hidden = true;
    const ui = new window.PagefindUI({
      element: "#search",
      showSubResults: true,
      resetStyles: false,
      autofocus: true,
      showEmptyFilters: false,
      openFilters: ["Category", "Language"],
      excerptLength: 15,
    });

    const q = new URLSearchParams(window.location.search).get("q");
    if (q) ui.triggerSearch(q);
  });
</script>
