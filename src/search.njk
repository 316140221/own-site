---
layout: layouts/base.njk
title: Search
showHeaderSearch: false
metaRobots: "noindex,follow"
pagefindBody: false
---

<h1 data-i18n="search.title">Search</h1>

<p class="muted" data-search-notice hidden role="status" aria-live="polite" data-i18n="search.notice">
  Search is temporarily unavailable.
</p>

<link rel="stylesheet" href="{{ '/pagefind/pagefind-ui.css' | url }}" />
<script src="{{ '/pagefind/pagefind-ui.js' | url }}" defer></script>

<p class="home-actions">
  <button
    class="button button-secondary"
    type="button"
    data-search-reset-filters
    hidden
    data-i18n="search.filters.reset"
  >
    Reset filters
  </button>
</p>

<div id="search"></div>
<div class="search-empty" data-search-empty hidden>
  <p data-i18n="search.zero_results_fallback">
    No matching results. Try trending stories or browse the latest feed.
  </p>
  <ul class="search-empty-links">
    <li><a href="{{ '/trending/' | url }}" data-i18n="search.fallback.trending">Trending</a></li>
    <li><a href="{{ '/page/1/' | url }}" data-i18n="search.fallback.latest">Latest</a></li>
    <li><a href="{{ '/categories/' | url }}" data-i18n="search.fallback.categories">Categories</a></li>
  </ul>
</div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const notice = document.querySelector("[data-search-notice]");
    if (!window.PagefindUI) {
      if (notice) notice.hidden = false;
      return;
    }
    if (notice) notice.hidden = true;

    const LANG_STORAGE_KEY = "site_lang";

    function normalizeLang(input) {
      const raw = String(input || "").trim().toLowerCase();
      if (!raw) return "";
      return raw.split("-")[0] || "";
    }

    function getSupportedLangs() {
      const raw = document.documentElement.getAttribute("data-supported-langs") || "";
      const list = raw
        .split(",")
        .map((l) => normalizeLang(l))
        .filter(Boolean);
      const unique = Array.from(new Set(list));
      return unique.length ? unique : ["en"];
    }

    function getDefaultLang() {
      return normalizeLang(document.documentElement.getAttribute("data-default-lang")) || "en";
    }

    function getLang() {
      const supported = getSupportedLangs();
      let stored = "";
      try {
        stored = normalizeLang(window.localStorage.getItem(LANG_STORAGE_KEY));
      } catch (_e) {}
      if (stored && supported.includes(stored)) return stored;
      try {
        if (typeof navigator !== "undefined" && Array.isArray(navigator.languages)) {
          for (const candidate of navigator.languages) {
            const normalized = normalizeLang(candidate);
            if (normalized && supported.includes(normalized)) return normalized;
          }
        }
        if (typeof navigator !== "undefined") {
          const fallback = normalizeLang(navigator.language);
          if (fallback && supported.includes(fallback)) return fallback;
        }
      } catch (_e) {}
      const def = getDefaultLang();
      if (def && supported.includes(def)) return def;
      return supported[0] || "en";
    }

    const TRANSLATIONS = {
      en: {
        placeholder: "Search…",
        search_label: "Search this site",
        clear_search: "Clear",
        load_more: "Load more",
        searching: "Searching for [SEARCH_TERM]…",
        zero_results: "No results for [SEARCH_TERM]. Try different keywords or reset filters.",
        one_result: "1 result for [SEARCH_TERM]",
        many_results: "[COUNT] results for [SEARCH_TERM]",
        zero_results_fallback: "No results found. Try trending or the latest feed.",
        fallback_trending: "Trending",
        fallback_latest: "Latest",
        fallback_categories: "Categories",
      },
      zh: {
        placeholder: "搜索…",
        search_label: "站内搜索",
        clear_search: "清除",
        load_more: "加载更多",
        searching: "正在搜索“[SEARCH_TERM]”…",
        zero_results: "未找到“[SEARCH_TERM]”的结果。可尝试更换关键词或重置筛选。",
        one_result: "“[SEARCH_TERM]” 共有 1 条结果",
        many_results: "“[SEARCH_TERM]” 共有 [COUNT] 条结果",
        zero_results_fallback: "没有匹配结果，试试热门或最新内容。",
        fallback_trending: "热门",
        fallback_latest: "最新",
        fallback_categories: "分类",
      },
    };

    function getTranslations(lang) {
      const key = normalizeLang(lang) || "en";
      return TRANSLATIONS[key] || TRANSLATIONS.en;
    }

    function t(key, vars) {
      if (window.SiteI18n && typeof window.SiteI18n.t === "function") {
        return window.SiteI18n.t(key, vars);
      }
      return String(key || "");
    }

    const FILTERS_STORAGE_KEY = "search_filters_v1";
    const resetBtn = document.querySelector("[data-search-reset-filters]");
    const searchRoot = document.getElementById("search");
    const emptyState = document.querySelector("[data-search-empty]");
    const searchAb = window.SearchAb || null;

    function storageGet(key) {
      try {
        return window.localStorage.getItem(key);
      } catch (_e) {
        return null;
      }
    }

    function storageSet(key, value) {
      try {
        window.localStorage.setItem(key, value);
      } catch (_e) {}
    }

    function storageRemove(key) {
      try {
        window.localStorage.removeItem(key);
      } catch (_e) {}
    }

    function readSavedFilters() {
      const raw = storageGet(FILTERS_STORAGE_KEY);
      if (!raw) return null;
      try {
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return null;
        return parsed;
      } catch (_e) {
        return null;
      }
    }

    function writeSavedFilters(filters) {
      if (!filters || typeof filters !== "object") {
        storageRemove(FILTERS_STORAGE_KEY);
        return;
      }
      if (!Object.keys(filters).length) {
        storageRemove(FILTERS_STORAGE_KEY);
        return;
      }
      storageSet(FILTERS_STORAGE_KEY, JSON.stringify(filters));
    }

    function readFiltersFromUrl() {
      try {
        const params = new URLSearchParams(window.location.search);
        const raw = params.get("filters");
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return null;
        return parsed;
      } catch (_e) {
        return null;
      }
    }

    function writeFiltersToUrl(filters) {
      try {
        const params = new URLSearchParams(window.location.search);
        if (!filters || typeof filters !== "object" || !Object.keys(filters).length) {
          params.delete("filters");
        } else {
          params.set("filters", JSON.stringify(filters));
        }
        const next = `${window.location.pathname}${
          params.toString() ? `?${params.toString()}` : ""
        }${window.location.hash || ""}`;
        window.history.replaceState({}, "", next);
      } catch (_e) {}
    }

    function persistFilters(filters) {
      writeSavedFilters(filters);
      writeFiltersToUrl(filters);
    }

    function getSearchInput() {
      if (!searchRoot) return null;
      const input = searchRoot.querySelector("input.pagefind-ui__search-input");
      return input instanceof HTMLInputElement ? input : null;
    }

    function getSearchQuery() {
      const input = getSearchInput();
      return input && input.value ? input.value.trim() : "";
    }

    function collectResultSnapshot() {
      if (!searchRoot) return [];
      const results = [];
      searchRoot.querySelectorAll(".pagefind-ui__result").forEach((resultEl, idx) => {
        if (!(resultEl instanceof HTMLElement)) return;
        const link = resultEl.querySelector("a[href]");
        if (!(link instanceof HTMLAnchorElement)) return;
        const href = link.getAttribute("href") || "";
        if (!href) return;
        const rank = idx + 1;
        resultEl.setAttribute("data-search-rank", String(rank));
        results.push({
          href,
          rank,
          title: link.textContent ? link.textContent.trim() : "",
        });
      });
      return results;
    }

    function refreshSearchTelemetry() {
      if (!searchAb) return;
      const results = collectResultSnapshot();
      if (!results.length) return;
      searchAb.recordImpression({
        query: getSearchQuery(),
        results,
      });
    }

    function setResetVisible(visible) {
      if (!resetBtn) return;
      resetBtn.hidden = !visible;
    }

    function getSelectedFiltersFromDom() {
      const out = {};
      if (!searchRoot) return out;

      searchRoot
        .querySelectorAll('input.pagefind-ui__filter-checkbox[type="checkbox"]')
        .forEach((el) => {
          if (!(el instanceof HTMLInputElement)) return;
          if (!el.checked) return;
          const group = String(el.name || "").trim();
          const value = String(el.value || "").trim();
          if (!group || !value) return;
          out[group] = out[group] || [];
          out[group].push(value);
        });

      return out;
    }

    function updateEmptyState() {
      if (!emptyState) return;
      const hasResults =
        searchRoot &&
        searchRoot.querySelector(".pagefind-ui__results") &&
        searchRoot.querySelector(".pagefind-ui__result");
      const messageEl = searchRoot ? searchRoot.querySelector(".pagefind-ui__message") : null;
      const searchInput =
        searchRoot && searchRoot.querySelector("input.pagefind-ui__search-input");
      const hasQuery = searchInput && searchInput.value && searchInput.value.trim().length;
      emptyState.hidden = Boolean(!hasQuery || hasResults || !messageEl);
    }

    function applyEmptyStateTranslations() {
      if (!emptyState) return;
      const dict = getTranslations(getLang());
      const text = emptyState.querySelector('[data-i18n="search.zero_results_fallback"]');
      if (text && dict.zero_results_fallback) text.textContent = dict.zero_results_fallback;

      const map = {
        "search.fallback.trending": dict.fallback_trending,
        "search.fallback.latest": dict.fallback_latest,
        "search.fallback.categories": dict.fallback_categories,
      };

      Object.entries(map).forEach(([key, value]) => {
        const el = emptyState.querySelector(`[data-i18n="${key}"]`);
        if (el && value) el.textContent = value;
      });
    }

    function applyFilterNameTranslations() {
      if (!searchRoot) return;
      const map = {
        Category: t("search.filters.category"),
        Language: t("search.filters.language"),
        Source: t("search.filters.source"),
      };

      searchRoot
        .querySelectorAll(".pagefind-ui__filter-name, .pagefind-ui__filter-group-label")
        .forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          const raw = el.textContent ? el.textContent.trim() : "";
          if (!raw) return;
          const next = map[raw];
          if (next) el.textContent = next;
        });
    }

    const q = new URLSearchParams(window.location.search).get("q");
    let ui = null;
    let bound = false;

    function getOpenFilters() {
      try {
        if (window.matchMedia && window.matchMedia("(max-width: 720px)").matches) return [];
      } catch (_e) {}
      return ["Category", "Language"];
    }

    function mount() {
      if (ui && typeof ui.destroy === "function") ui.destroy();
      ui = new window.PagefindUI({
        element: "#search",
        showSubResults: true,
        resetStyles: false,
        autofocus: true,
        showEmptyFilters: false,
        openFilters: getOpenFilters(),
        excerptLength: 15,
        translations: getTranslations(getLang()),
      });

      const urlFilters = readFiltersFromUrl();
      const saved = readSavedFilters();
      const initialFilters = urlFilters || saved;
      if (initialFilters && typeof ui.triggerFilters === "function") {
        ui.triggerFilters(initialFilters);
        persistFilters(initialFilters);
        setResetVisible(true);
      } else {
        setResetVisible(false);
      }

      if (q) ui.triggerSearch(q);
      applyFilterNameTranslations();
      applyEmptyStateTranslations();
      updateEmptyState();
      refreshSearchTelemetry();
    }

    function bind() {
      if (bound) return;
      bound = true;

      if (searchRoot) {
        searchRoot.addEventListener("change", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (!target.closest(".pagefind-ui__filter-checkbox")) return;
          const selected = getSelectedFiltersFromDom();
          persistFilters(selected);
          setResetVisible(Boolean(Object.keys(selected).length));
          applyFilterNameTranslations();
          updateEmptyState();
        });

        const observer = new MutationObserver(() => {
          applyFilterNameTranslations();
          updateEmptyState();
          refreshSearchTelemetry();
        });
        observer.observe(searchRoot, { childList: true, subtree: true });

        searchRoot.addEventListener("input", updateEmptyState);
        searchRoot.addEventListener("click", (event) => {
          if (!searchAb) return;
          const target = event.target;
          if (!(target instanceof Element)) return;
          const anchor = target.closest(".pagefind-ui__result a");
          if (!(anchor instanceof HTMLAnchorElement)) return;
          const href = anchor.getAttribute("href") || "";
          if (!href) return;
          const wrap = anchor.closest(".pagefind-ui__result");
          const rankAttr = wrap ? wrap.getAttribute("data-search-rank") : null;
          const rank = rankAttr ? Number(rankAttr) : undefined;
          searchAb.recordClick({
            href,
            rank: Number.isFinite(rank) ? rank : undefined,
            query: getSearchQuery(),
            title: anchor.textContent ? anchor.textContent.trim() : "",
          });
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener("click", () => {
          persistFilters(null);
          if (ui && typeof ui.triggerFilters === "function") ui.triggerFilters({});
          setResetVisible(false);
          applyFilterNameTranslations();
          updateEmptyState();
        });
      }
    }

    bind();
    mount();
    window.addEventListener("site:lang", mount);
  });
</script>
