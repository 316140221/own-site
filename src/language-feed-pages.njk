---
layout: null
eleventyExcludeFromCollections: true
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "lang/{{ lang.code }}/feed.xml"
---
{% set items = (('data/indexes/by-language/' + lang.code + '.json') | readJson) or [] %}
<?xml version="1.0" encoding="UTF-8"?>
<rss
  version="2.0"
  xmlns:atom="http://www.w3.org/2005/Atom"
  xmlns:media="http://search.yahoo.com/mrss/"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
>
  <channel>
    {% set channelLink = (('/lang/' + lang.code + '/') | url) | absoluteUrl(site.url) %}
    {% set iconUrl = ('/assets/favicon.svg' | url) | absoluteUrl(site.url) %}
    <title>{{ (site.name + ' - ' + lang.label) | xmlEscape | safe }}</title>
    <link>{{ channelLink | xmlEscape | safe }}</link>
    <description>{{ ('Latest items in ' + lang.label + '.') | xmlEscape | safe }}</description>
    <language>{{ lang.code | xmlEscape | safe }}</language>
    <lastBuildDate>{{ buildTime | rfc822 }}</lastBuildDate>
    <generator>{{ (site.name + ' (Eleventy)') | xmlEscape | safe }}</generator>
    <ttl>120</ttl>
    <copyright>{{ ('© ' + buildTime.getUTCFullYear() + ' ' + site.name) | xmlEscape | safe }}</copyright>
    <atom:link href="{{ ('/lang/' + lang.code + '/feed.xml') | url | absoluteUrl(site.url) }}" rel="self" type="application/rss+xml" />
    <image>
      <url>{{ iconUrl | xmlEscape | safe }}</url>
      <title>{{ (site.name + ' - ' + lang.label) | xmlEscape | safe }}</title>
      <link>{{ channelLink | xmlEscape | safe }}</link>
    </image>

    {% for item in items %}
      {% if loop.index0 < 50 %}
        {% set itemLink = ('/p/' + item.id + '/') | url | absoluteUrl(site.url) %}
        <item>
          <title>{{ item.title | decodeEntities | xmlEscape | safe }}</title>
          <link>{{ itemLink | xmlEscape | safe }}</link>
          <guid isPermaLink="false">{{ item.id | xmlEscape | safe }}</guid>
          <pubDate>{{ item.publishedAt | rfc822 }}</pubDate>
          {% if item.source and item.source.name %}
            <dc:creator>{{ item.source.name | xmlEscape | safe }}</dc:creator>
          {% endif %}
          <dc:language>{{ lang.code | xmlEscape | safe }}</dc:language>
          {% if item.category %}
            <category>{{ item.category | xmlEscape | safe }}</category>
          {% endif %}
          <description>{{ (item.summary or '') | xmlEscape | safe }}</description>
          {% if item.image %}
            <media:thumbnail url="{{ item.image | xmlEscape | safe }}" />
          {% endif %}
        </item>
      {% endif %}
    {% endfor %}
  </channel>
</rss>
