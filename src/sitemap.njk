---
permalink: /sitemap.xml
layout: null
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>{{ sitemaps.coreSitemap | url | absoluteUrl(site.url) }}</loc>
    <lastmod>{{ buildTime | formatDate }}</lastmod>
  </sitemap>
  {% if sitemaps and sitemaps.articleSitemaps and sitemaps.articleSitemaps.length %}
    {% for p in sitemaps.articleSitemaps %}
      <sitemap>
        <loc>{{ p | url | absoluteUrl(site.url) }}</loc>
        <lastmod>{{ buildTime | formatDate }}</lastmod>
      </sitemap>
    {% endfor %}
  {% endif %}
</sitemapindex>

