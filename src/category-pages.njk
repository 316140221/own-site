---
layout: layouts/base.njk
pagination:
  data: categoryPages
  size: 1
  alias: catPage
permalink: "category/{{ catPage.slug }}/{% if catPage.pageNumber == 0 %}{% else %}page/{{ catPage.pageNumber + 1 }}/{% endif %}index.html"
eleventyComputed:
  title: "{{ catPage.label }}{% if catPage.pageNumber > 0 %} · Page {{ catPage.pageNumber + 1 }}{% endif %}"
  description: "Latest {{ catPage.label }} stories and links from our RSS sources.{% if catPage.pageNumber > 0 %} Page {{ catPage.pageNumber + 1 }}.{% endif %}"
  rssPath: "/category/{{ catPage.slug }}/feed.xml"
  metaRobots: "{% if catPage.items and catPage.items.length %}{% else %}noindex,follow{% endif %}"
---

<h1>{{ catPage.label }}</h1>
{% set items = catPage.items %}
{% include "partials/news-list.njk" %}
{% if catPage.totalPages > 1 %}
  {% include "partials/category-pager.njk" %}
{% endif %}
