---
layout: null
eleventyExcludeFromCollections: true
pagination:
  data: articles
  size: 5000
  alias: chunk
permalink: "/sitemaps/articles-{{ pagination.pageNumber + 1 }}.xml"
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% if chunk and chunk.length %}
    {% for entry in chunk %}
      <url>
        <loc>{{ ('/p/' + entry.id + '/') | url | absoluteUrl(site.url) }}</loc>
        {% if entry.publishedAt %}
          <lastmod>{{ entry.publishedAt | formatDate }}</lastmod>
        {% endif %}
      </url>
    {% endfor %}
  {% endif %}
</urlset>

