{
  "name": "own-site",
  "version": "1.0.0",
  "description": "Zero-cost news aggregator: RSS -> JSON -> static site -> GitHub Pages",
  "private": true,
  "scripts": {
    "dev": "eleventy --serve",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "build": "node scripts/clean-dist.mjs && npm run prepare:assets && eleventy && node scripts/post-build-cache.mjs",
    "fetch": "node scripts/fetch.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "archive": "node scripts/archive.mjs",
    "indexes": "node scripts/build-indexes.mjs",
    "update": "node scripts/update.mjs",
    "loop:update": "node scripts/loop.mjs -- node scripts/update.mjs",
    "loop:update:5h": "node scripts/loop.mjs --times 1000000 --duration-ms 18000000 --continue-on-fail -- node scripts/update.mjs",
    "check:tasks": "node scripts/check-tasks.mjs",
    "import:opml": "node scripts/import-opml.mjs",
    "pagefind": "node scripts/pagefind-incremental.mjs",
    "audit:dist": "node scripts/audit-dist.mjs",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "audit:nav": "node scripts/audit-nav-accessibility.mjs",
    "build:site": "npm run build && npm run pagefind && npm run audit:dist && npm run audit:lighthouse",
    "restore:archive": "node scripts/restore-archive.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "luxon": "^3.7.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "pagefind": "^1.4.0"
  }
}
